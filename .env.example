# =====================================================================
# TEMPLATE KONFIGURASI ENVIRONMENT (PORTFOLIO SAFE)
# Salin file ini menjadi .env lalu sesuaikan dengan kredensial Anda.
# JANGAN PERNAH meng-commit file .env yang berisi password atau API Key.
# =====================================================================

# Kredensial MetaTrader 5 (MT5 IPC Desktop)
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=FinexBisnisSolusi-Demo
MT5_ACCOUNT_TYPE=demo
MT5_PATH=

# Guard Akun Real (0 = Block Order Real / Fail-Closed, 1 = Izinkan jika benar-benar siap)
ALLOW_LIVE_REAL=0

# API Key Google Gemini (Opsional: untuk modul analisis sentimen & pre-trade briefing)
# Dapatkan di Google AI Studio (https://aistudio.google.com/)
GEMINI_API_KEY=
