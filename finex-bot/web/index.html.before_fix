        </div>

        <div>
          <label class="block text-xs font-semibold text-slate-400 mb-1">Nomor Akun MT5 (Login)</label>
          <input type="number" id="loginLogin" value="61950031" class="w-full bg-slate-900 border border-slate-700 p-2.5 rounded-lg font-mono text-sm text-white focus:outline-none focus:border-blue-500" placeholder="61950031" />
        </div>

        <div>
          <label class="block text-xs font-semibold text-slate-400 mb-1">Password</label>
          <input type="password" id="loginPassword" value="" class="w-full bg-slate-900 border border-slate-700 p-2.5 rounded-lg text-sm text-white focus:outline-none focus:border-blue-500" placeholder="Biarkan kosong jika MT5 Desktop sudah login" />
        </div>

        <div>
          <label class="block text-xs font-semibold text-slate-400 mb-1">Nama Server Broker</label>
          <input type="text" id="loginServer" value="FinexBisnisSolusi-Demo" class="w-full bg-slate-900 border border-slate-700 p-2.5 rounded-lg font-mono text-xs text-white focus:outline-none focus:border-blue-500" />
        </div>
      </div>

      <div class="pt-3 border-t border-slate-800 flex items-center gap-2">
        <button type="button" onclick="submitLogin()" class="flex-1 py-2.5 rounded-lg bg-blue-600 text-white font-bold text-xs hover:bg-blue-500 transition shadow-lg shadow-blue-600/30">
          Hubungkan MT5
        </button>
        <button type="button" onclick="disconnectToPaper()" class="py-2.5 px-4 rounded-lg bg-slate-800 text-slate-300 font-semibold text-xs hover:bg-slate-700 transition">
          Gunakan Simulator
        </button>
      </div>
    </div>
  </div>

  <!-- MODAL ATURAN STRATEGI & RISIKO -->
  <div id="modalRules" class="fixed inset-0 bg-black/80 backdrop-blur-sm z-50 hidden flex items-center justify-center p-4">
    <div class="trade-card w-full max-w-xl p-6 space-y-4 border border-slate-700">
      <div class="flex items-center justify-between pb-3 border-b border-slate-800">
        <h3 class="text-base font-bold text-white flex items-center gap-2">
          <i class="fa-solid fa-shield-halved text-cyan-400"></i> Aturan Disiplin & Manajemen Risiko
        </h3>
        <button onclick="closeModal('modalRules')" class="w-8 h-8 rounded-lg bg-slate-800 text-slate-400 hover:text-white flex items-center justify-center">
          <i class="fa-solid fa-xmark"></i>
        </button>
      </div>

      <div class="space-y-3 text-xs text-slate-300 leading-relaxed max-h-[360px] overflow-y-auto custom-scroll pr-1">
        <div class="p-3 rounded-xl bg-slate-900 border border-slate-800">
          <strong class="text-amber-400 block mb-1">1. Zona Fibonacci Golden Ratio (50% - 78.6%)</strong>
          Bot mengukur swing high dan swing low. Entri beli atau jual hanya dieksekusi saat harga melakukan koreksi sehat ke zona 50.0% s/d 78.6%, bukan mengejar harga yang sudah naik tinggi.
        </div>
        <div class="p-3 rounded-xl bg-slate-900 border border-slate-800">
          <strong class="text-emerald-400 block mb-1">2. Target Take Profit Ekstensi -0.27</strong>
          Target profit ditetapkan pada level ekstensi Fibonacci -0.27 untuk mencapai rasio keuntungan minimal 1:1.5 hingga 1:2.0.
        </div>
        <div class="p-3 rounded-xl bg-slate-900 border border-slate-800">
          <strong class="text-rose-400 block mb-1">3. Circuit Breaker Harian -3.0 R</strong>
          Batas maksimal toleransi rugi dalam 1 hari adalah 3 kali risiko standar (-3.0 R). Jika tercapai, bot otomatis mengunci trading hari itu agar modal tidak tergerus emosi pasar.
        </div>
        <div class="p-3 rounded-xl bg-slate-900 border border-slate-800">
          <strong class="text-blue-400 block mb-1">4. Proteksi Impas Otomatis (Break-Even)</strong>
          Ketika posisi sudah berjalan profit mencapai +1.0 R, Stop Loss otomatis digeser ke titik impas (harga buka) agar posisi bebas risiko rugi.
        </div>
      </div>
    </div>
  </div>

  <!-- MODAL BACKTEST SIMULASI LAB -->
  <div id="modalBacktest" class="fixed inset-0 bg-black/80 backdrop-blur-sm z-50 hidden flex items-center justify-center p-4">
    <div class="trade-card w-full max-w-xl p-6 space-y-4 border border-slate-700">
      <div class="flex items-center justify-between pb-3 border-b border-slate-800">
        <h3 class="text-base font-bold text-white flex items-center gap-2">
          <i class="fa-solid fa-flask text-cyan-400"></i> Laboratorium Simulasi Backtest
        </h3>
        <button onclick="closeModal('modalBacktest')" class="w-8 h-8 rounded-lg bg-slate-800 text-slate-400 hover:text-white flex items-center justify-center">
          <i class="fa-solid fa-xmark"></i>
        </button>
      </div>

      <div class="grid grid-cols-2 gap-3 text-xs">
        <div>
          <label class="block text-slate-400 mb-1">Pilih Data Riwayat CSV</label>
          <select id="btDataset" class="w-full bg-slate-900 border border-slate-700 p-2 rounded-lg text-white font-mono focus:outline-none">
            <option value="data/EURUSD_M5.csv">EURUSD M5 (Sample)</option>
            <option value="data/BTCUSD_M5.csv">BTCUSD M5 (Sample)</option>
          </select>
        </div>
        <div>
          <label class="block text-slate-400 mb-1">Timeframe</label>
          <select id="btTimeframe" class="w-full bg-slate-900 border border-slate-700 p-2 rounded-lg text-white font-mono focus:outline-none">
            <option value="M5">5 Menit (M5)</option>
            <option value="M15">15 Menit (M15)</option>
            <option value="H1">1 Jam (H1)</option>
          </select>
        </div>
      </div>

      <div>
        <button type="button" id="btnRunBt" onclick="runBacktest()" class="w-full py-2.5 rounded-lg bg-cyan-600 hover:bg-cyan-500 text-white font-bold text-xs transition flex items-center justify-center gap-2">
          <i class="fa-solid fa-play"></i> Jalankan Pengujian
        </button>
      </div>

      <div id="btResultsContainer" class="hidden pt-3 border-t border-slate-800 space-y-2">
        <span class="text-xs font-bold text-slate-300">Hasil Pengujian Algoritma:</span>
        <div id="btMetricsGrid" class="grid grid-cols-4 gap-2 text-xs"></div>
      </div>
    </div>
  </div>

  <!-- ==================================================== -->
  <!-- 6. ENGINE JAVASCRIPT REAL-TIME                       -->
  <!-- ==================================================== -->
  <script>
    let socket = null;
    let telemetryData = null;
    let latestPositions = [];
    let latestCandles = [];
    let latestFib = null;
    let currentSymbol = 'EURUSD';
    let currentTimeframe = 'M5';
    let isBotRunning = false;

    const allSyms = ['EURUSD', 'GBPUSD', 'USDJPY', 'AUDUSD', 'XAUUSD', 'XAGUSD', 'BTCUSD', 'ETHUSD'];

    function openModal(id) {
      const el = document.getElementById(id);
      if (el) el.classList.remove('hidden');
    }
    function closeModal(id) {
      const el = document.getElementById(id);
      if (el) el.classList.add('hidden');
    }

    function switchTableTab(tab) {
      const cPos = document.getElementById('containerPositions');
      const cHist = document.getElementById('containerHistory');
      const bPos = document.getElementById('tabPosBtn');
      const bHist = document.getElementById('tabHistBtn');

      if (tab === 'positions') {
        cPos.classList.remove('hidden');
        cHist.classList.add('hidden');
        bPos.className = 'px-4 py-2 rounded-xl bg-blue-600 text-white font-bold text-xs transition flex items-center gap-2 shadow-sm';
        bHist.className = 'px-4 py-2 rounded-xl bg-slate-800 text-slate-300 hover:text-white font-bold text-xs transition flex items-center gap-2';
      } else {
        cPos.classList.add('hidden');
        cHist.classList.remove('hidden');
        bHist.className = 'px-4 py-2 rounded-xl bg-blue-600 text-white font-bold text-xs transition flex items-center gap-2 shadow-sm';
        bPos.className = 'px-4 py-2 rounded-xl bg-slate-800 text-slate-300 hover:text-white font-bold text-xs transition flex items-center gap-2';
      }
    }

    // WebSocket Telemetry Connection
    function initWebSocket() {
      const protocol = window.location.protocol === 'https:' ? 'wss:' : 'ws:';
      const wsUrl = `${protocol}//${window.location.host}/ws/telemetry`;
      socket = new WebSocket(wsUrl);

      socket.onopen = () => {
        document.getElementById('statusText').innerText = 'TERHUBUNG';
        document.getElementById('statusDot').className = 'w-2.5 h-2.5 rounded-full bg-emerald-500 pulse-green';
      };

      socket.onmessage = (event) => {
        try {
          const msg = JSON.parse(event.data);
          if (msg.type === 'telemetry' || msg.type === 'initial_status') {
            updateUI(msg.data);
          }
        } catch (e) {
          console.error(e);
        }
      };

      socket.onclose = () => {
        document.getElementById('statusText').innerText = 'PUTUS (MENGHUBUNGKAN...)';
        document.getElementById('statusDot').className = 'w-2.5 h-2.5 rounded-full bg-amber-500';
        setTimeout(initWebSocket, 2000);
      };
    }

    // Update Terminal UI from Telemetry Stream
    function updateUI(data) {
      telemetryData = data;
      const acc = data.account || {};

      // Status Akun MT5
      const mode = acc.mode || 'PAPER';
      const badgeMode = document.getElementById('badgeMode');
      const btnHeaderLoginText = document.getElementById('btnHeaderLoginText');
      const btnReconnect = document.getElementById('btnReconnect');
      const accServerLabel = document.getElementById('accServerLabel');

      if (mode.startsWith('MT5')) {
        const loginNum = acc.login || '61950031';
        badgeMode.innerText = `${mode === 'MT5_REAL' ? 'MT5 REAL' : 'MT5 DEMO'} (#${loginNum})`;
        accServerLabel.innerText = `${acc.server || 'FinexBisnisSolusi-Demo'} • Direct IPC Aktif`;
        if (btnHeaderLoginText) btnHeaderLoginText.innerText = 'Ganti Akun MT5';
        if (btnReconnect) btnReconnect.classList.add('hidden');
      } else {
        badgeMode.innerText = 'PAPER SIMULATOR';
        accServerLabel.innerText = 'Mode Percobaan Lokal (Tanpa Risiko)';
        if (btnHeaderLoginText) btnHeaderLoginText.innerText = 'Login MT5';
        if (btnReconnect) btnReconnect.classList.add('hidden');
      }

      // Status Bot (Start / Stop)
      isBotRunning = data.is_running || false;
      const badgeBot = document.getElementById('badgeBotStatusText');
      const botDesc = document.getElementById('botStatusDesc');
      const btnToggle = document.getElementById('btnMainBotToggle');

      if (isBotRunning) {
        badgeBot.innerText = 'SEDANG BERJALAN';
        badgeBot.className = 'px-2.5 py-0.5 rounded-full text-[10px] font-bold bg-emerald-500/20 text-emerald-400 border border-emerald-500/40 animate-pulse';
        botDesc.innerText = 'Bot sedang aktif memantau pasar secara otomatis.';
        btnToggle.className = 'w-full py-2.5 px-4 rounded-xl font-bold text-xs text-white bg-rose-600 hover:bg-rose-500 transition shadow-lg shadow-rose-600/30 flex items-center justify-center gap-2';
        btnToggle.innerHTML = `<i class="fa-solid fa-pause"></i> <span>HENTIKAN BOT (PAUSE)</span>`;
      } else {
        badgeBot.innerText = 'BERHENTI';
        badgeBot.className = 'px-2.5 py-0.5 rounded-full text-[10px] font-bold bg-slate-800 text-slate-400 border border-slate-700';
        botDesc.innerText = 'Bot berhenti. Klik tombol hijau di bawah untuk menjalankan.';
        btnToggle.className = 'w-full py-2.5 px-4 rounded-xl font-bold text-xs text-white bg-emerald-600 hover:bg-emerald-500 transition shadow-lg shadow-emerald-600/30 flex items-center justify-center gap-2';
        btnToggle.innerHTML = `<i class="fa-solid fa-play"></i> <span>JALANKAN BOT SEKARANG</span>`;
      }

      // Harga Real-time (Bid & Ask)
      const sym = data.symbol || currentSymbol;
      const dec = (sym.includes('XAU') || sym.includes('BTC') || sym.includes('ETH') || sym.includes('XAG')) ? 2 : (sym.includes('JPY') ? 3 : 5);
      
      if (data.bid !== undefined && data.bid !== null) {
        document.getElementById('tickerBid').innerText = Number(data.bid).toFixed(dec);
        const elSell = document.getElementById('sellLivePriceBadge');
        if (elSell) elSell.innerText = Number(data.bid).toFixed(dec);
      }
      if (data.ask !== undefined && data.ask !== null) {
        document.getElementById('tickerAsk').innerText = Number(data.ask).toFixed(dec);
        const elBuy = document.getElementById('buyLivePriceBadge');
        if (elBuy) elBuy.innerText = Number(data.ask).toFixed(dec);
      }
      const sp = (data.spread_pips !== undefined) ? data.spread_pips : 0.8;
      document.getElementById('tickerSpread').innerText = `${Number(sp).toFixed(1)} pip`;

      // Saldo & Ekuitas
      const curBal = acc.balance !== undefined ? acc.balance : 47134.32;
      const curEq = acc.equity !== undefined ? acc.equity : curBal;
      document.getElementById('valBalance').innerText = `$${curBal.toLocaleString(undefined, {minimumFractionDigits: 2})}`;
      document.getElementById('valEquity').innerText = `$${curEq.toLocaleString(undefined, {minimumFractionDigits: 2})}`;
      
      const freeMarg = acc.free_margin !== undefined ? acc.free_margin : curEq;
      const elFreeMarg = document.getElementById('valFreeMargin');
      if (elFreeMarg) elFreeMarg.innerText = `$${freeMarg.toLocaleString(undefined, {minimumFractionDigits: 2})}`;

      // Untung Hari Ini
      const profToday = acc.profit_today !== undefined ? acc.profit_today : (acc.floating_pnl || 0);
      const profTodayPct = acc.profit_today_pct !== undefined ? acc.profit_today_pct : 0.0;
      const elProfToday = document.getElementById('valProfitToday');
      const elProfTodayPct = document.getElementById('valProfitTodayPct');
      if (elProfToday) {
        const sign = profToday >= 0 ? '+' : '';
        elProfToday.innerText = `${sign}$${profToday.toFixed(2)}`;
        elProfToday.className = profToday >= 0 ? 'text-2xl font-extrabold text-emerald-400 font-mono' : 'text-2xl font-extrabold text-rose-400 font-mono';
      }
      if (elProfTodayPct) {
        const sign = profTodayPct >= 0 ? '+' : '';
        elProfTodayPct.innerText = `(${sign}${profTodayPct.toFixed(2)}%)`;
        elProfTodayPct.className = `text-xs font-bold font-mono ${profTodayPct >= 0 ? 'text-emerald-400' : 'text-rose-400'}`;
      }

      // Saldo Awal & Estimasi Besok
      const dailyStart = acc.daily_start_balance !== undefined ? acc.daily_start_balance : curBal;
      document.getElementById('valDailyStartBal').innerText = `$${dailyStart.toLocaleString(undefined, {minimumFractionDigits: 2})}`;

      const estBalTom = acc.est_balance_tomorrow !== undefined ? acc.est_balance_tomorrow : (curBal + (acc.floating_pnl || 0));
      document.getElementById('valEstBalTomorrow').innerText = `$${estBalTom.toLocaleString(undefined, {minimumFractionDigits: 2})}`;

      // Untung Bulan Ini
      const profMonth = acc.profit_month !== undefined ? acc.profit_month : profToday;
      const profMonthPct = acc.profit_month_pct !== undefined ? acc.profit_month_pct : profTodayPct;
      const elProfMonth = document.getElementById('valProfitMonth');
      const elProfMonthPct = document.getElementById('valProfitMonthPct');
      if (elProfMonth) {
        const signM = profMonth >= 0 ? '+' : '';
        elProfMonth.innerText = `${signM}$${profMonth.toFixed(2)}`;
        elProfMonth.className = profMonth >= 0 ? 'text-2xl font-extrabold text-emerald-400 font-mono' : 'text-2xl font-extrabold text-rose-400 font-mono';
      }
      if (elProfMonthPct) {
        const signM = profMonthPct >= 0 ? '+' : '';
        elProfMonthPct.innerText = `(${signM}${profMonthPct.toFixed(2)}%)`;
        elProfMonthPct.className = `text-xs font-bold font-mono ${profMonthPct >= 0 ? 'text-emerald-400' : 'text-rose-400'}`;
      }

      document.getElementById('valCircuit').innerText = `${Number(data.daily_r || 0).toFixed(1)} R`;

      // Posisi, Riwayat & Log
      latestPositions = data.positions || data.open_positions || [];
      renderPositions(latestPositions);
      renderHistory(data.trade_history || []);
      renderLogs(data.logs || []);

      // Redraw Chart
      if (latestCandles && latestCandles.length > 0) {
        drawCandlestickChart(latestCandles, latestFib);
      }
    }

    // Render Tabel Posisi Aktif
    function renderPositions(posList) {
      const tbody = document.getElementById('positionsTableBody');
      const countEl = document.getElementById('countPositions');
      if (countEl) countEl.innerText = posList.length;
      if (!tbody) return;

      if (!posList || posList.length === 0) {
        tbody.innerHTML = `<tr><td colspan="10" class="p-6 text-center text-slate-500 italic font-sans text-xs">Tidak ada posisi terbuka saat ini. Bot sedang memindai peluang retracement Fibonacci...</td></tr>`;
        return;
      }

      let html = '';
      posList.forEach(p => {
        const pnl = Number(p.floating_pnl || 0);
        const pnlColor = pnl >= 0 ? 'text-emerald-400 font-bold' : 'text-rose-400 font-bold';
        const sideColor = p.side === 'BUY' ? 'bg-emerald-500/20 text-emerald-400 border-emerald-500/40' : 'bg-rose-500/20 text-rose-400 border-rose-500/40';
        const dec = p.symbol.includes('XAU') ? 2 : 5;
        html += `
          <tr class="hover:bg-slate-800/50 transition text-xs border-b border-slate-800">
            <td class="p-2.5 font-bold text-slate-300">#${p.ticket}</td>
            <td class="p-2.5 font-bold text-white">${p.symbol}</td>
            <td class="p-2.5"><span class="px-2 py-0.5 rounded text-[10px] font-bold border ${sideColor}">${p.side}</span></td>
            <td class="p-2.5 text-slate-200">${p.lots} Lot</td>
            <td class="p-2.5 text-slate-200">${Number(p.open_price).toFixed(dec)}</td>
            <td class="p-2.5 text-cyan-400">${Number(p.current_price || p.open_price).toFixed(dec)}</td>
            <td class="p-2.5 text-rose-400">${p.sl ? Number(p.sl).toFixed(dec) : '-'}</td>
            <td class="p-2.5 text-emerald-400">${p.tp ? Number(p.tp).toFixed(dec) : '-'}</td>
            <td class="p-2.5 ${pnlColor}">${pnl >= 0 ? '+' : ''}$${pnl.toFixed(2)}</td>
            <td class="p-2.5 text-right">
              <button onclick="closeTrade(${p.ticket})" class="px-3 py-1 rounded bg-rose-600/20 hover:bg-rose-600 text-rose-300 hover:text-white font-bold text-[11px] border border-rose-600/40 transition">
                Tutup
              </button>
            </td>
          </tr>
        `;
      });
      tbody.innerHTML = html;
    }

    // Render Tabel Riwayat Selesai
    function renderHistory(histList) {
      const tbody = document.getElementById('historyTableBody');
      const countEl = document.getElementById('countHistory');
      const countClosed = document.getElementById('countClosedTrades');
      if (countEl) countEl.innerText = histList.length;
      if (countClosed) countClosed.innerText = histList.length;
      if (!tbody) return;

      if (!histList || histList.length === 0) {
        tbody.innerHTML = `<tr><td colspan="8" class="p-6 text-center text-slate-500 italic font-sans text-xs">Belum ada riwayat transaksi selesai pada sesi ini.</td></tr>`;
        return;
      }

      let html = '';
      histList.slice(0, 30).forEach(t => {
        const pnl = Number(t.profit !== undefined ? t.profit : t.pnl || 0);
        const pnlColor = pnl >= 0 ? 'text-emerald-400 font-bold' : 'text-rose-400 font-bold';
        const sideColor = t.side === 'BUY' ? 'bg-emerald-500/20 text-emerald-400' : 'bg-rose-500/20 text-rose-400';
        html += `
          <tr class="hover:bg-slate-800/50 transition text-xs border-b border-slate-800">
            <td class="p-2.5 font-bold text-slate-400">#${t.ticket}</td>
            <td class="p-2.5 font-bold text-white">${t.symbol}</td>
            <td class="p-2.5"><span class="px-2 py-0.5 rounded text-[10px] font-bold ${sideColor}">${t.side}</span></td>
            <td class="p-2.5 text-slate-300">${t.lots} Lot</td>
            <td class="p-2.5 text-slate-300">${Number(t.open_price).toFixed(2)}</td>
            <td class="p-2.5 text-slate-300">${Number(t.close_price).toFixed(2)}</td>
            <td class="p-2.5 ${pnlColor}">${pnl >= 0 ? '+' : ''}$${pnl.toFixed(2)}</td>
            <td class="p-2.5 text-slate-400 font-sans text-[11px]">${t.close_time || 'Baru saja'}</td>
          </tr>
        `;
      });
      tbody.innerHTML = html;
    }

    // Render Log Aktivitas Bot
    function renderLogs(logs) {
      if (!logs || logs.length === 0) return;
      const feed = document.getElementById('activityFeedList');
      if (!feed) return;

      let html = '';
      logs.slice(-6).reverse().forEach(line => {
        let borderCol = 'border-slate-800';
        let textCol = 'text-slate-300';
        if (line.includes('BUY') || line.includes('Order')) {
          borderCol = 'border-emerald-500/30 bg-emerald-500/5';
          textCol = 'text-emerald-300';
        } else if (line.includes('SELL')) {
          borderCol = 'border-rose-500/30 bg-rose-500/5';
          textCol = 'text-rose-300';
        } else if (line.includes('LOGIN')) {
          borderCol = 'border-blue-500/30 bg-blue-500/5';
          textCol = 'text-blue-300';
        }
        html += `
          <div class="p-2 rounded border ${borderCol} ${textCol} leading-snug">
            ${line}
          </div>
        `;
      });
      feed.innerHTML = html;
    }

    // Pemilihan Simbol Pasar
    async function selectSymbol(symbol, desc, category) {
      currentSymbol = symbol;
      
      document.getElementById('labelActiveSymbol').innerText = symbol;
      document.getElementById('labelActiveCategory').innerText = category;

      // Update warna tombol pilihan
      ['EURUSD', 'GBPUSD', 'XAUUSD', 'BTCUSD'].forEach(s => {
        const btn = document.getElementById(`btnSym-${s}`);
        if (btn) {
          if (s === symbol) {
            btn.className = 'px-3 py-1.5 rounded-lg text-xs font-mono font-bold bg-blue-600 text-white transition';
          } else {
            btn.className = 'px-3 py-1.5 rounded-lg text-xs font-mono font-bold bg-slate-800 text-slate-300 hover:bg-slate-700 transition';
          }
        }
      });

      // Tampilkan notifikasi akhir pekan jika memilih forex/emas saat weekend
      const d = new Date().getDay(); // 0 = Minggu, 6 = Sabtu
      const notice = document.getElementById('weekendNotice');
      if (notice) {
        if ((d === 0 || d === 6) && (category === 'FOREX' || category === 'COMMODITY')) {
          notice.classList.remove('hidden');
        } else {
          notice.classList.add('hidden');
        }
      }

      // Beritahu backend
      try {
        await fetch('/api/bot/configure', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ symbol: symbol, timeframe: currentTimeframe })
        });
      } catch (e) {
        console.error(e);
      }
      refreshChart();
    }

    async function selectTimeframe(tf) {
      currentTimeframe = tf;
      ['M1', 'M5', 'M15', 'H1'].forEach(t => {
        const btn = document.getElementById(`tfBtn-${t}`);
        if (btn) {
          btn.className = (t === tf) ? 'px-2.5 py-1 rounded bg-blue-600 text-white font-bold transition' : 'px-2.5 py-1 rounded text-slate-400 hover:text-white transition';
        }
      });
      refreshChart();
    }

    // Mengambil lilin data chart & menggambar
    async function refreshChart() {
      try {
        const res = await fetch(`/api/candles?symbol=${currentSymbol}&timeframe=${currentTimeframe}&count=80`);
        const data = await res.json();
        latestCandles = data.candles || [];
        latestFib = data.fib_levels || null;
        drawCandlestickChart(latestCandles, latestFib);
      } catch (e) {
        console.error(e);
      }
    }

    // Menggambar Candlestick & Fibonacci Chart
    function drawCandlestickChart(candles, fib) {
      const canvas = document.getElementById('liveChartCanvas');
      if (!canvas || !candles || candles.length === 0) return;
      const ctx = canvas.getContext('2d');
      const dpr = window.devicePixelRatio || 1;
      const rect = canvas.getBoundingClientRect();
      canvas.width = rect.width * dpr;
      canvas.height = rect.height * dpr;
      ctx.scale(dpr, dpr);

      const w = rect.width;
      const h = rect.height;
      const axisW = (currentSymbol.includes('BTC') || currentSymbol.includes('ETH')) ? 84 : 70;
      const chartW = w - axisW;

      ctx.clearRect(0, 0, w, h);

      const numDec = (currentSymbol.includes('XAU') || currentSymbol.includes('BTC') || currentSymbol.includes('ETH') || currentSymbol.includes('XAG')) ? 2 : (currentSymbol.includes('JPY') ? 3 : 5);

      let minP = Math.min(...candles.map(c => c.low));
      let maxP = Math.max(...candles.map(c => c.high));

      const curLivePrice = (telemetryData && telemetryData.bid && telemetryData.symbol === currentSymbol) ? telemetryData.bid : candles[candles.length - 1].close;
      minP = Math.min(minP, curLivePrice);
      maxP = Math.max(maxP, curLivePrice);

      if (fib) {
        if (fib.leg_low && !isNaN(fib.leg_low)) minP = Math.min(minP, fib.leg_low);
        if (fib.leg_high && !isNaN(fib.leg_high)) maxP = Math.max(maxP, fib.leg_high);
        if (fib.tp_target && !isNaN(fib.tp_target)) {
          minP = Math.min(minP, fib.tp_target);
          maxP = Math.max(maxP, fib.tp_target);
        }
      }

      // Pastikan posisi terbuka dan SL/TP masuk ke skala vertikal chart
      const activeForSymbol = (latestPositions || []).filter(p => (p.symbol || '').toUpperCase() === currentSymbol.toUpperCase());
      activeForSymbol.forEach(p => {
        if (p.open_price) { minP = Math.min(minP, Number(p.open_price)); maxP = Math.max(maxP, Number(p.open_price)); }
        if (p.sl && p.sl > 0) { minP = Math.min(minP, Number(p.sl)); maxP = Math.max(maxP, Number(p.sl)); }
        if (p.tp && p.tp > 0) { minP = Math.min(minP, Number(p.tp)); maxP = Math.max(maxP, Number(p.tp)); }
      });

      const padding = (maxP - minP) * 0.14 || 0.0005;
      minP -= padding;
      maxP += padding;

      const toY = (p) => h - ((p - minP) / (maxP - minP)) * (h - 40) - 20;

      // Garis Grid Horizontal & Label Harga di Kanan
      ctx.strokeStyle = 'rgba(255, 255, 255, 0.06)';
      ctx.lineWidth = 1;
      ctx.fillStyle = '#64748B';
      ctx.font = '10px monospace';
      ctx.textAlign = 'right';

      for (let i = 0; i <= 5; i++) {
        const py = 20 + (i * (h - 40)) / 5;
        const pVal = maxP - (i / 5) * (maxP - minP);
        ctx.beginPath();
        ctx.moveTo(0, py);
        ctx.lineTo(chartW, py);
        ctx.stroke();
        ctx.fillText(pVal.toFixed(numDec), w - 6, py + 3);
      }

      // Garis Pembatas Sumbu Y
      ctx.strokeStyle = 'rgba(255, 255, 255, 0.12)';
      ctx.beginPath();
      ctx.moveTo(chartW, 0);
      ctx.lineTo(chartW, h);
      ctx.stroke();

      // Arsiran Zona Fibonacci Golden Zone (50% - 78.6%)
      if (fib && fib.fib_50 && fib.fib_786) {
        const badgeTrend = document.getElementById('chartTrendBadge');
        if (badgeTrend) badgeTrend.innerText = fib.trend || 'TREND ACTIVE';

        const yTop = toY(Math.max(fib.fib_50, fib.fib_786));
        const yBot = toY(Math.min(fib.fib_50, fib.fib_786));

        // Area Emas Transparan
        ctx.fillStyle = 'rgba(245, 158, 11, 0.12)';
        ctx.fillRect(0, yTop, chartW, yBot - yTop);

        const drawFibLine = (price, label, col) => {
          const y = toY(price);
          ctx.strokeStyle = col;
          ctx.setLineDash([4, 4]);
          ctx.beginPath();
          ctx.moveTo(0, y);
          ctx.lineTo(chartW, y);
          ctx.stroke();
          ctx.setLineDash([]);
          ctx.fillStyle = col;
          ctx.font = 'bold 9px sans-serif';
          ctx.textAlign = 'left';
          ctx.fillText(label, 8, y - 3);
        };

        drawFibLine(fib.fib_50, 'Fib 50.0% (Golden Entry)', '#F59E0B');
        drawFibLine(fib.fib_786, 'Fib 78.6% (Batas Zona)', '#D97706');
        drawFibLine(fib.tp_target, 'Target TP Ekstensi (-0.27)', '#10B981');
      }

      // Menggambar Lilin Candlestick
      const n = candles.length;
      const barSpacing = chartW / n;
      const barWidth = Math.max(2, barSpacing * 0.65);

      candles.forEach((c, idx) => {
        const x = idx * barSpacing + barSpacing / 2;
        const isBull = c.close >= c.open;
        const color = isBull ? '#10B981' : '#EF4444';

        // Sumbu Lilin
        ctx.strokeStyle = color;
        ctx.lineWidth = 1.2;
        ctx.beginPath();
        ctx.moveTo(x, toY(c.high));
        ctx.lineTo(x, toY(c.low));
        ctx.stroke();

        // Badan Lilin
        const yOpen = toY(c.open);
        const yClose = toY(c.close);
        const top = Math.min(yOpen, yClose);
        const bodyH = Math.max(1.5, Math.abs(yClose - yOpen));

        ctx.fillStyle = color;
        ctx.fillRect(x - barWidth / 2, top, barWidth, bodyH);
      });

      // Garis Harga Real-Time (Live Price)
      const curY = toY(curLivePrice);
      ctx.strokeStyle = '#06B6D4';
      ctx.lineWidth = 1.2;
      ctx.setLineDash([3, 3]);
      ctx.beginPath();
      ctx.moveTo(0, curY);
      ctx.lineTo(chartW, curY);
      ctx.stroke();
      ctx.setLineDash([]);

      // Label Harga di Sumbu Kanan
      ctx.fillStyle = '#06B6D4';
      ctx.beginPath();
      ctx.roundRect(chartW + 2, curY - 9, axisW - 4, 18, 4);
      ctx.fill();

      ctx.fillStyle = '#0B0F19';
      ctx.font = 'bold 9px monospace';
      ctx.textAlign = 'center';
      ctx.fillText(curLivePrice.toFixed(numDec), chartW + (axisW / 2), curY + 3.5);

      // Gambar Garis Posisi Beli / Jual Langsung di Chart
      activeForSymbol.forEach(p => {
        const isBuy = (p.side || '').toUpperCase() === 'BUY';
        const yEntry = toY(Number(p.open_price));
        const col = isBuy ? '#10B981' : '#EF4444';
        const pnl = Number(p.floating_pnl || 0);

        // Garis Dashed Entry
        ctx.strokeStyle = col;
        ctx.lineWidth = 1.6;
        ctx.setLineDash([6, 3]);
        ctx.beginPath();
        ctx.moveTo(0, yEntry);
        ctx.lineTo(chartW, yEntry);
        ctx.stroke();
        ctx.setLineDash([]);

        // Badge Lencana Posisi di Sisi Kiri
        const label = `${p.side} ${p.lots}L @ ${Number(p.open_price).toFixed(numDec)} (${pnl >= 0 ? '+' : ''}$${pnl.toFixed(2)})`;
        ctx.font = 'bold 9px monospace';
        const bw = ctx.measureText(label).width + 16;
        
        ctx.fillStyle = col;
        ctx.beginPath();
        ctx.roundRect(8, yEntry - 10, bw, 20, 4);
        ctx.fill();

        ctx.fillStyle = '#FFFFFF';
        ctx.textAlign = 'left';
        ctx.fillText(label, 16, yEntry + 3.5);

        // Garis Stop Loss jika ada
        if (p.sl && Number(p.sl) > 0) {
          const ySl = toY(Number(p.sl));
          ctx.strokeStyle = '#EF4444';
          ctx.lineWidth = 1.2;
          ctx.setLineDash([3, 3]);
          ctx.beginPath();
          ctx.moveTo(0, ySl); ctx.lineTo(chartW, ySl);
          ctx.stroke();
          ctx.setLineDash([]);
          ctx.fillStyle = '#EF4444';
          ctx.font = 'bold 9px monospace';
          ctx.textAlign = 'right';
          ctx.fillText(`SL: ${Number(p.sl).toFixed(numDec)}`, chartW - 8, ySl - 4);
        }

        // Garis Take Profit jika ada
        if (p.tp && Number(p.tp) > 0) {
          const yTp = toY(Number(p.tp));
          ctx.strokeStyle = '#10B981';
          ctx.lineWidth = 1.2;
          ctx.setLineDash([3, 3]);
          ctx.beginPath();
          ctx.moveTo(0, yTp); ctx.lineTo(chartW, yTp);
          ctx.stroke();
          ctx.setLineDash([]);
          ctx.fillStyle = '#10B981';
          ctx.font = 'bold 9px monospace';
          ctx.textAlign = 'right';
          ctx.fillText(`TP: ${Number(p.tp).toFixed(numDec)}`, chartW - 8, yTp - 4);
        }
      });
    }

    // Toggle Tombol Utama Bot (Mulai / Hentikan)
    async function toggleMainBot() {
      const action = isBotRunning ? 'stop' : 'start';
      await controlBot(action);
    }

    async function controlBot(action) {
      try {
        const res = await fetch(`/api/bot/${action}`, { method: 'POST' });
        const data = await res.json();
        console.log(data);
      } catch (e) {
        alert(`Gagal ${action}: ` + e);
      }
    }

    function adjustLot(delta) {
      const inp = document.getElementById('manualLotInput');
      let val = (parseFloat(inp.value) || 0.01) + delta;
      val = Math.max(0.01, Math.min(100.0, val));
      inp.value = val.toFixed(2);
    }

    function setLotPreset(val) {
      document.getElementById('manualLotInput').value = val.toFixed(2);
    }

    async function executeManualOrder(side) {
      const lot = parseFloat(document.getElementById('manualLotInput').value) || 0.01;
      try {
        const res = await fetch('/api/trades/quick-order', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ symbol: currentSymbol, side: side, lots: lot })
        });
        const data = await res.json();
        if (!res.ok) alert(data.detail || 'Gagal eksekusi order');
      } catch (e) {
        alert('Gagal order: ' + e);
      }
    }

    async function closeTrade(ticket) {
      try {
        const res = await fetch(`/api/trades/close/${ticket}`, { method: 'POST' });
        const data = await res.json();
        if (!res.ok) alert(data.detail || 'Gagal tutup posisi');
      } catch (e) {
        alert('Gagal tutup posisi: ' + e);
      }
    }

    async function closeAllTrades() {
      if (!confirm('Tutup semua posisi aktif sekarang?')) return;
      try {
        const res = await fetch('/api/trades/close-all', { method: 'POST' });
        const data = await res.json();
        alert(data.message || 'Semua posisi ditutup.');
      } catch (e) {
        alert('Gagal: ' + e);
      }
    }

    async function quickSetBreakEven() {
      if (!latestPositions || latestPositions.length === 0) {
        alert('Tidak ada posisi terbuka untuk dikunci impas.');
        return;
      }
      for (const p of latestPositions) {
        await fetch(`/api/trades/break-even/${p.ticket}`, { method: 'POST' });
      }
      alert('Perintah Break-Even (Kunci Impas) berhasil dikirim.');
    }

    async function manualReconnect() {
      try {
        const res = await fetch('/api/account/reconnect', { method: 'POST' });
        const data = await res.json();
        alert(data.message || 'Proses sambung ulang selesai.');
      } catch (e) {
        alert('Gagal sambung ulang: ' + e);
      }
    }

    // Modal Login MT5
    function openLoginModal() {
      openModal('loginModal');
    }
    function closeLoginModal() {
      closeModal('loginModal');
    }

    let selectedAccType = 'DEMO';
    function selectAccountType(t) {
      selectedAccType = t;
      const bDemo = document.getElementById('btnAccDemo');
      const bReal = document.getElementById('btnAccReal');
      if (t === 'DEMO') {
        bDemo.className = 'p-2 rounded-lg bg-emerald-600/20 border border-emerald-500 text-emerald-400 text-xs font-bold';
        bReal.className = 'p-2 rounded-lg bg-slate-800 border border-slate-700 text-slate-400 text-xs font-bold';
      } else {
        bReal.className = 'p-2 rounded-lg bg-rose-600/20 border border-rose-500 text-rose-400 text-xs font-bold';
        bDemo.className = 'p-2 rounded-lg bg-slate-800 border border-slate-700 text-slate-400 text-xs font-bold';
      }
    }

    async function submitLogin() {
      const login = parseInt(document.getElementById('loginLogin').value);
      const password = document.getElementById('loginPassword').value;
      const server = document.getElementById('loginServer').value;

      try {
        const res = await fetch('/api/account/login', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            login: login,
            password: password,
            server: server,
            account_type: selectedAccType
          })
        });
        const data = await res.json();
        if (res.ok) {
          alert('Login Berhasil! MT5 Terhubung.');
          closeLoginModal();
        } else {
          alert('Login gagal: ' + (data.detail || 'Cek terminal MT5 Anda.'));
        }
      } catch (e) {
        alert('Error: ' + e);
      }
    }

    async function disconnectToPaper() {
      try {
        await fetch('/api/account/disconnect', { method: 'POST' });
        alert('Beralih ke mode Paper Simulator');
        closeLoginModal();
      } catch (e) {
        alert('Error: ' + e);
      }
    }

    // Backtest
    async function runBacktest() {
      const btn = document.getElementById('btnRunBt');
      btn.disabled = true;
      btn.innerHTML = `<i class="fa-solid fa-spinner fa-spin"></i> Menghitung...`;

      try {
        const body = {
          csv_file: document.getElementById('btDataset').value,
          timeframe: document.getElementById('btTimeframe').value,
          sl_mode: 'SWING_EXACT',
          use_break_even: true,
          use_session_filter: true
        };

        const res = await fetch('/api/backtest/run', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(body)
        });

        const data = await res.json();
        renderBacktestStats(data.stats);
      } catch (e) {
        alert('Gagal backtest: ' + e);
      } finally {
        btn.disabled = false;
        btn.innerHTML = `<i class="fa-solid fa-play"></i> Jalankan Pengujian`;
      }
    }

    function renderBacktestStats(s) {
      const container = document.getElementById('btResultsContainer');
      const grid = document.getElementById('btMetricsGrid');
      container.classList.remove('hidden');

      grid.innerHTML = `
        <div class="bg-slate-900 p-2 rounded border border-slate-800">
          <span class="text-slate-400 block text-[9px] uppercase font-bold">TOTAL TRADES</span>
          <span class="text-sm font-bold text-white font-mono">${s.trades}</span>
        </div>
        <div class="bg-slate-900 p-2 rounded border border-slate-800">
          <span class="text-slate-400 block text-[9px] uppercase font-bold">WIN RATE</span>
          <span class="text-sm font-bold text-emerald-400 font-mono">${s.win_rate}%</span>
        </div>
        <div class="bg-slate-900 p-2 rounded border border-slate-800">
          <span class="text-slate-400 block text-[9px] uppercase font-bold">PROFIT FACTOR</span>
          <span class="text-sm font-bold text-cyan-400 font-mono">${s.profit_factor}</span>
        </div>
        <div class="bg-slate-900 p-2 rounded border border-slate-800">
          <span class="text-slate-400 block text-[9px] uppercase font-bold">TOTAL R</span>
          <span class="text-sm font-bold ${s.total_r >= 0 ? 'text-emerald-400' : 'text-rose-400'} font-mono">${s.total_r >= 0 ? '+' : ''}${s.total_r}R</span>
        </div>
      `;
    }

    function exportTradesCSV() {
      if (!telemetryData || !telemetryData.trade_history || telemetryData.trade_history.length === 0) {
        alert('Belum ada riwayat transaksi untuk diunduh.');
        return;
      }
      const trades = telemetryData.trade_history;
      let csv = 'NoTiket,Pasangan,Tipe,Lot,HargaBuka,HargaTutup,UntungRugi,WaktuSelesai\n';
      trades.forEach(t => {
        csv += `${t.ticket},${t.symbol},${t.side},${t.lots},${t.open_price},${t.close_price},${t.profit || t.pnl || 0},"${t.close_time || ''}"\n`;
      });
      const blob = new Blob([csv], { type: 'text/csv' });
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = `Riwayat_Trade_Finex_${new Date().toISOString().slice(0, 10)}.csv`;
      a.click();
    }

    // Startup
    window.addEventListener('load', () => {
      initWebSocket();
      refreshChart();
      window.addEventListener('resize', () => {
        if (latestCandles.length > 0) drawCandlestickChart(latestCandles, latestFib);
      });
    });
  </script>
</body>
</html>
