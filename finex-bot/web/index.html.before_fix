<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Finex Trade Pro - Terminal Algoritma & Trading</title>
  
  <!-- Fonts: Plus Jakarta Sans & JetBrains Mono -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  
  <!-- Tailwind CSS -->
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          fontFamily: {
            sans: ['"Plus Jakarta Sans"', 'system-ui', 'sans-serif'],
            mono: ['"JetBrains Mono"', 'monospace'],
          },
          colors: {
            appDark: '#0B0F19',
            cardDark: '#131B2E',
            cardBorder: '#1E293B',
            tradeGreen: '#10B981',
            tradeRed: '#EF4444',
            tradeGold: '#F59E0B',
            tradeBlue: '#3B82F6',
            tradeCyan: '#06B6D4',
          }
        }
      }
    }
  </script>
  
  <!-- Font Awesome 6 Icons -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
  
  <style>
    body {
      background-color: #0B0F19;
      color: #F1F5F9;
      font-family: 'Plus Jakarta Sans', sans-serif;
      margin: 0;
      padding: 0;
      -webkit-font-smoothing: antialiased;
    }

    /* Kartu Trading Bersih & Kontras Tinggi */
    .trade-card {
      background: #131B2E;
      border: 1px solid #1E293B;
      border-radius: 16px;
      box-shadow: 0 4px 20px -2px rgba(0, 0, 0, 0.4);
    }

    .trade-card-glow {
      background: #131B2E;
      border: 1px solid #2563EB;
      border-radius: 16px;
      box-shadow: 0 0 25px -5px rgba(37, 99, 235, 0.25);
    }

    .custom-scroll::-webkit-scrollbar { width: 6px; height: 6px; }
    .custom-scroll::-webkit-scrollbar-track { background: #0B0F19; }
    .custom-scroll::-webkit-scrollbar-thumb { background: #334155; border-radius: 4px; }
    .custom-scroll::-webkit-scrollbar-thumb:hover { background: #475569; }

    .pulse-green { animation: pulseGreen 2s infinite; }
    @keyframes pulseGreen {
      0%, 100% { opacity: 1; transform: scale(1); filter: drop-shadow(0 0 4px #10B981); }
      50% { opacity: 0.4; transform: scale(0.9); }
    }
  </style>
</head>
<body class="min-h-screen flex flex-col p-2 sm:p-3 md:p-4 lg:p-5 w-full overflow-x-hidden text-slate-100">

  <!-- ==================================================== -->
  <!-- 1. TOP HEADER: STATUS AKUN & KONEKSI MT5             -->
  <!-- ==================================================== -->
  <header class="w-full mb-3 md:mb-4 trade-card px-3 sm:px-4 md:px-6 py-2.5 sm:py-3 flex flex-wrap items-center justify-between gap-3 sm:gap-4">
    
    <!-- Logo & Nama Aplikasi -->
    <div class="flex items-center gap-3">
      <div class="w-10 h-10 rounded-xl bg-gradient-to-tr from-blue-600 to-cyan-500 flex items-center justify-center text-white text-lg shadow-md shadow-blue-500/30">
        <i class="fa-solid fa-chart-line"></i>
      </div>
      <div>
        <h1 class="text-base font-extrabold tracking-tight text-white flex items-center gap-2">
          FINEX TRADE PRO <span class="text-xs px-2 py-0.5 rounded-full bg-blue-500/20 text-blue-400 font-mono font-bold border border-blue-500/30">ALGO V2.0</span>
        </h1>
        <p class="text-[11px] text-slate-400">Terminal Trading Otomatis & Analisis Fibonacci Institusional</p>
      </div>
    </div>

    <!-- Status Koneksi Akun MT5 -->
    <div class="flex items-center gap-3 flex-wrap">
      
      <!-- Lencana Mode Akun -->
      <div class="flex items-center gap-2.5 bg-slate-900/80 px-4 py-2 rounded-xl border border-slate-700/80">
        <div id="statusDot" class="w-2.5 h-2.5 rounded-full bg-emerald-500 pulse-green"></div>
        <div class="text-left">
          <div class="flex items-center gap-1.5">
            <span class="text-xs font-bold text-white font-mono" id="badgeMode">MT5 DEMO (#61950031)</span>
            <span class="text-[9px] px-1.5 py-0.2 rounded font-bold bg-emerald-500/20 text-emerald-400 uppercase" id="statusText">TERHUBUNG</span>
          </div>
          <span class="text-[10px] text-slate-400 block" id="accServerLabel">FinexBisnisSolusi-Demo • Direct IPC</span>
        </div>
      </div>

      <!-- Tombol Reconnect (jika putus) -->
      <button id="btnReconnect" onclick="manualReconnect()" class="hidden px-3.5 py-2 rounded-xl bg-amber-500/20 text-amber-300 border border-amber-500/40 text-xs font-bold hover:bg-amber-500/30 transition flex items-center gap-1.5">
        <i class="fa-solid fa-rotate"></i> Sambung Ulang
      </button>

      <!-- Tombol Ganti Akun / Login -->
      <button onclick="openLoginModal()" class="px-4 py-2 rounded-xl bg-blue-600 hover:bg-blue-500 text-white font-bold text-xs transition flex items-center gap-2 shadow-md shadow-blue-600/30">
        <i class="fa-solid fa-key"></i> <span id="btnHeaderLoginText">Ganti Akun MT5</span>
      </button>

      <!-- Tombol Buka Panduan Aturan -->
      <button onclick="openModal('modalRules')" class="px-3.5 py-2 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-300 font-bold text-xs transition border border-slate-700 flex items-center gap-1.5" title="Aturan & Manajemen Risiko">
        <i class="fa-solid fa-shield-halved text-cyan-400"></i> Aturan Risiko
      </button>
    </div>
  </header>

  <!-- ==================================================== -->
  <!-- 2. KARTU RINGKASAN KEUANGAN & KONTROL BOT (4 KARTU)  -->
  <!-- ==================================================== -->
  <div class="w-full grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3 sm:gap-4 mb-3 md:mb-4">
    
    <!-- KARTU 1: SALDO & EKUITAS -->
    <div class="trade-card p-4 flex flex-col justify-between">
      <div class="flex items-center justify-between text-slate-400 text-xs font-semibold">
        <span>SALDO & EKUITAS</span>
        <i class="fa-solid fa-wallet text-blue-400"></i>
      </div>
      <div class="my-2">
        <span class="text-xs text-slate-400 block">Ekuitas Real-Time:</span>
        <div class="text-2xl font-extrabold text-white font-mono" id="valEquity">$47,134.32</div>
        <span class="text-xs text-slate-400 mt-1 block">Saldo Modal: <strong class="text-slate-200 font-mono" id="valBalance">$47,134.32</strong></span>
      </div>
      <div class="pt-2 border-t border-slate-800 text-[11px] text-slate-400 flex items-center justify-between">
        <span>Margin Bebas:</span>
        <span class="font-mono text-slate-300 font-bold" id="valFreeMargin">$47,134.32</span>
      </div>
    </div>

    <!-- KARTU 2: UNTUNG HARI INI & ESTIMASI BESOK -->
    <div class="trade-card p-4 flex flex-col justify-between">
      <div class="flex items-center justify-between text-slate-400 text-xs font-semibold">
        <span>KEUNTUNGAN HARI INI</span>
        <i class="fa-solid fa-chart-line-up text-emerald-400"></i>
      </div>
      <div class="my-2">
        <span class="text-xs text-slate-400 block">Profit / Rugi Hari Ini:</span>
        <div class="flex items-baseline gap-2">
          <span class="text-2xl font-extrabold text-emerald-400 font-mono" id="valProfitToday">+$0.00</span>
          <span class="text-xs font-bold text-emerald-400 font-mono" id="valProfitTodayPct">(+0.00%)</span>
        </div>
        <span class="text-xs text-slate-400 mt-1 block">Saldo Awal Hari Ini: <strong class="text-slate-200 font-mono" id="valDailyStartBal">$47,134.32</strong></span>
      </div>
      <div class="pt-2 border-t border-slate-800 text-[11px] text-slate-400 flex items-center justify-between">
        <span>Estimasi Saldo Besok:</span>
        <span class="font-mono text-cyan-400 font-bold" id="valEstBalTomorrow">$47,134.32</span>
      </div>
    </div>

    <!-- KARTU 3: UNTUNG BULANAN & BATAS RISIKO -->
    <div class="trade-card p-4 flex flex-col justify-between">
      <div class="flex items-center justify-between text-slate-400 text-xs font-semibold">
        <span>BULAN INI & BATAS RISIKO</span>
        <i class="fa-solid fa-shield text-amber-400"></i>
      </div>
      <div class="my-2">
        <span class="text-xs text-slate-400 block">Profit 30 Hari Terakhir:</span>
        <div class="flex items-baseline gap-2">
          <span class="text-2xl font-extrabold text-emerald-400 font-mono" id="valProfitMonth">+$0.00</span>
          <span class="text-xs font-bold text-emerald-400 font-mono" id="valProfitMonthPct">(+0.00%)</span>
        </div>
        <span class="text-xs text-slate-400 mt-1 block">Batas Rugi Harian: <strong class="text-amber-400 font-mono" id="valCircuit">0.0 R</strong> <span class="text-[10px] text-slate-500">(Maks -3.0R)</span></span>
      </div>
      <div class="pt-2 border-t border-slate-800 text-[11px] text-slate-400 flex items-center justify-between">
        <span>Total Trade Ditutup:</span>
        <span class="font-mono text-slate-300 font-bold"><span id="countClosedTrades">0</span> Trade</span>
      </div>
    </div>

    <!-- KARTU 4: SAKELAR UTAMA BOT (START / STOP) -->
    <div class="trade-card p-4 flex flex-col justify-between border-2 border-blue-500/40 bg-gradient-to-b from-blue-950/30 to-slate-900">
      <div class="flex items-center justify-between text-xs font-bold">
        <span class="text-slate-300">STATUS BOT OTOMATIS</span>
        <span id="badgeBotStatusText" class="px-2.5 py-0.5 rounded-full text-[10px] font-bold bg-slate-800 text-slate-400 border border-slate-700">BERHENTI</span>
      </div>
      <div class="my-2">
        <p class="text-xs text-slate-300" id="botStatusDesc">
          Bot siap memindai zona Fibonacci Golden Ratio (50% - 78.6%).
        </p>
      </div>
      <!-- Tombol Aksi Utama Mulai / Stop -->
      <div class="pt-2 border-t border-slate-800">
        <button type="button" id="btnMainBotToggle" onclick="toggleMainBot()" class="w-full py-2.5 px-4 rounded-xl font-bold text-xs text-white bg-emerald-600 hover:bg-emerald-500 transition shadow-lg shadow-emerald-600/30 flex items-center justify-center gap-2">
          <i class="fa-solid fa-play"></i> <span>JALANKAN BOT SEKARANG</span>
        </button>
      </div>
    </div>

  </div>

  <!-- ==================================================== -->
  <!-- 3. AREA KERJA UTAMA: CHART (KIRI) & ORDER (KANAN)     -->
  <!-- ==================================================== -->
  <div class="w-full grid grid-cols-1 lg:grid-cols-12 xl:grid-cols-12 gap-3 sm:gap-4 mb-3 md:mb-4 flex-1">
    
    <!-- SISI KIRI: CHART TRADINGVIEW STYLE (8 KOLOM) -->
    <div class="lg:col-span-8 xl:col-span-9 trade-card p-3 sm:p-4 md:p-5 flex flex-col justify-between">
      
      <!-- BAR PILIHAN PASAR & TIMEFRAME -->
      <div class="flex flex-wrap items-center justify-between gap-3 pb-3 border-b border-slate-800">
        
        <!-- Tab Kategori: Forex, Emas, Kripto -->
        <div class="flex items-center gap-1.5 overflow-x-auto custom-scroll pb-1 sm:pb-0 flex-nowrap sm:flex-wrap max-w-full">
          <span class="text-xs font-bold text-slate-400 mr-1 hidden sm:inline">Pasar:</span>
          
          <!-- Tombol Forex EURUSD -->
          <button type="button" onclick="selectSymbol('EURUSD', 'Euro vs US Dollar', 'FOREX')" id="btnSym-EURUSD" class="px-3 py-1.5 rounded-lg text-xs font-mono font-bold bg-blue-600 text-white transition">
            EURUSD
          </button>
          
          <!-- Tombol GBPUSD -->
          <button type="button" onclick="selectSymbol('GBPUSD', 'British Pound', 'FOREX')" id="btnSym-GBPUSD" class="px-3 py-1.5 rounded-lg text-xs font-mono font-bold bg-slate-800 text-slate-300 hover:bg-slate-700 transition">
            GBPUSD
          </button>
          
          <!-- Tombol Emas XAUUSD -->
          <button type="button" onclick="selectSymbol('XAUUSD', 'Emas (Gold Spot)', 'COMMODITY')" id="btnSym-XAUUSD" class="px-3 py-1.5 rounded-lg text-xs font-mono font-bold bg-slate-800 text-amber-400 hover:bg-slate-700 transition flex items-center gap-1">
            <i class="fa-solid fa-gem text-[10px]"></i> XAUUSD (Emas)
          </button>
          
          <!-- Tombol Kripto BTCUSD 24/7 -->
          <button type="button" onclick="selectSymbol('BTCUSD', 'Bitcoin 24 Jam Nonstop', 'CRYPTO')" id="btnSym-BTCUSD" class="px-3 py-1.5 rounded-lg text-xs font-mono font-bold bg-slate-800 text-cyan-400 hover:bg-slate-700 transition flex items-center gap-1 border border-cyan-500/30">
            <i class="fa-brands fa-bitcoin text-[11px]"></i> BTCUSD <span class="text-[9px] px-1 py-0.2 rounded bg-cyan-500/20 text-cyan-300 font-bold">24/7</span>
          </button>
        </div>

        <!-- Pilihan Timeframe -->
        <div class="flex items-center gap-1 bg-slate-900 p-1 rounded-lg border border-slate-800 text-xs font-mono">
          <button type="button" onclick="selectTimeframe('M1')" id="tfBtn-M1" class="px-2.5 py-1 rounded text-slate-400 hover:text-white transition">1M</button>
          <button type="button" onclick="selectTimeframe('M5')" id="tfBtn-M5" class="px-2.5 py-1 rounded bg-blue-600 text-white font-bold transition">5M</button>
          <button type="button" onclick="selectTimeframe('M15')" id="tfBtn-M15" class="px-2.5 py-1 rounded text-slate-400 hover:text-white transition">15M</button>
          <button type="button" onclick="selectTimeframe('H1')" id="tfBtn-H1" class="px-2.5 py-1 rounded text-slate-400 hover:text-white transition">1H</button>
        </div>

      </div>

      <!-- INFO HARGA REAL-TIME & LEVEL FIBONACCI -->
      <div class="flex flex-wrap items-center justify-between gap-2 py-2.5 text-xs">
        <!-- Simbol & Harga Bid/Ask -->
        <div class="flex items-center gap-3">
          <div class="flex items-baseline gap-1.5">
            <span class="text-lg font-extrabold text-white font-mono" id="labelActiveSymbol">EURUSD</span>
            <span class="text-[10px] font-bold px-2 py-0.5 rounded bg-blue-500/20 text-blue-400" id="labelActiveCategory">FOREX</span>
          </div>
          <div class="font-mono text-xs text-slate-300 flex items-center gap-2">
            <span>Bid: <strong class="text-cyan-400" id="tickerBid">1.11882</strong></span>
            <span>Ask: <strong class="text-slate-100" id="tickerAsk">1.11890</strong></span>
            <span class="text-slate-400 text-[11px]">(Spread: <span id="tickerSpread">0.8 pip</span>)</span>
          </div>
        </div>

        <!-- Info Zona Fibonacci -->
        <div class="flex items-center gap-2 text-[11px] font-mono">
          <span class="px-2 py-0.5 rounded bg-amber-500/10 text-amber-400 border border-amber-500/30 flex items-center gap-1">
            <i class="fa-solid fa-bullseye text-[10px]"></i> Golden Zone: <strong>50% - 78.6%</strong>
          </span>
          <span class="px-2 py-0.5 rounded bg-emerald-500/10 text-emerald-400 border border-emerald-500/30 flex items-center gap-1">
            <i class="fa-solid fa-flag-checkered text-[10px]"></i> TP: <strong>-0.27 Target</strong>
          </span>
          <span id="chartTrendBadge" class="px-2 py-0.5 rounded bg-slate-800 text-slate-300 font-bold">TREND DETECTING</span>
        </div>
      </div>

      <!-- KANVAS CHART CANDLESTICK LENGKAP -->
      <div class="relative w-full h-[380px] sm:h-[450px] md:h-[500px] lg:h-[560px] xl:h-[620px] rounded-xl overflow-hidden bg-[#070A12] border border-slate-800">
        <canvas id="liveChartCanvas" class="w-full h-full block"></canvas>

        <!-- Petunjuk Keterangan Garis di Chart -->
        <div class="absolute bottom-2 left-3 flex items-center gap-3 bg-slate-900/90 px-3 py-1.5 rounded-lg border border-slate-800 text-[10px] text-slate-300 pointer-events-none">
          <span class="flex items-center gap-1.5"><span class="w-2.5 h-2.5 bg-emerald-500 rounded-sm inline-block"></span> Lilin Naik (Bullish)</span>
          <span class="flex items-center gap-1.5"><span class="w-2.5 h-2.5 bg-rose-500 rounded-sm inline-block"></span> Lilin Turun (Bearish)</span>
          <span class="flex items-center gap-1.5"><span class="w-3 h-0.5 bg-amber-500 inline-block border-t border-dashed"></span> Zona Fibonacci</span>
          <span class="flex items-center gap-1.5"><span class="w-3 h-0.5 bg-cyan-400 inline-block border-t border-dashed"></span> Harga Live</span>
        </div>

        <!-- Notifikasi jika Akhir Pekan pasar Forex Tutup -->
        <div id="weekendNotice" class="hidden absolute top-3 right-3 bg-amber-500/20 text-amber-300 border border-amber-500/40 px-3 py-1.5 rounded-lg text-xs font-semibold backdrop-blur-md flex items-center gap-2">
          <i class="fa-solid fa-clock"></i> Pasar Forex & Emas tutup saat akhir pekan. Pilih <strong>BTCUSD</strong> untuk trading live 24/7.
        </div>
      </div>

    </div>

    <!-- SISI KANAN: PANEL ORDER MANUAL & KONTROL CEPAT (4 KOLOM) -->
    <div class="lg:col-span-4 xl:col-span-3 space-y-3 sm:space-y-4">
      
      <!-- KOTAK 1: EKSEKUSI ORDER MANUAL (BELI / JUAL) -->
      <div class="trade-card p-4 space-y-3.5">
        <div class="flex items-center justify-between pb-2 border-b border-slate-800">
          <span class="text-xs font-bold uppercase tracking-wider text-slate-300 flex items-center gap-1.5">
            <i class="fa-solid fa-hand-pointer text-blue-400"></i> Eksekusi Manual
          </span>
          <span class="text-[10px] font-mono text-cyan-400 bg-cyan-500/10 px-2 py-0.5 rounded border border-cyan-500/20">Instan 1-Klik</span>
        </div>

        <!-- Pemilihan Ukuran Lot -->
        <div>
          <div class="flex items-center justify-between text-xs text-slate-300 mb-1.5 font-semibold">
            <span>Ukuran Lot:</span>
            <span class="text-[11px] text-slate-400">Min 0.01 / Maks 100</span>
          </div>
          <div class="flex items-center gap-2">
            <button type="button" onclick="adjustLot(-0.01)" class="w-10 h-10 rounded-lg bg-slate-800 hover:bg-slate-700 text-white font-mono font-bold text-sm border border-slate-700 transition">-</button>
            <input type="number" id="manualLotInput" value="0.01" step="0.01" min="0.01" max="100" class="flex-1 bg-slate-900 border border-slate-700 p-2 rounded-lg text-center font-mono font-extrabold text-white text-base focus:outline-none focus:border-blue-500" />
            <button type="button" onclick="adjustLot(+0.01)" class="w-10 h-10 rounded-lg bg-slate-800 hover:bg-slate-700 text-white font-mono font-bold text-sm border border-slate-700 transition">+</button>
          </div>
          
          <!-- Tombol Cepat Pilihan Lot -->
          <div class="grid grid-cols-4 gap-1.5 mt-2">
            <button type="button" onclick="setLotPreset(0.01)" class="py-1 rounded bg-slate-800 hover:bg-slate-700 text-[11px] font-mono text-slate-300 font-bold border border-slate-700">0.01</button>
            <button type="button" onclick="setLotPreset(0.05)" class="py-1 rounded bg-slate-800 hover:bg-slate-700 text-[11px] font-mono text-slate-300 font-bold border border-slate-700">0.05</button>
            <button type="button" onclick="setLotPreset(0.10)" class="py-1 rounded bg-slate-800 hover:bg-slate-700 text-[11px] font-mono text-slate-300 font-bold border border-slate-700">0.10</button>
            <button type="button" onclick="setLotPreset(1.00)" class="py-1 rounded bg-slate-800 hover:bg-slate-700 text-[11px] font-mono text-slate-300 font-bold border border-slate-700">1.00</button>
          </div>
        </div>

        <!-- Tombol Besar BUY & SELL -->
        <div class="grid grid-cols-2 gap-3 pt-1">
          <!-- Tombol BELI (BUY) -->
          <button type="button" onclick="executeManualOrder('BUY')" class="p-3.5 rounded-xl bg-emerald-600 hover:bg-emerald-500 active:scale-95 text-white font-extrabold text-sm transition flex flex-col items-center justify-center gap-1 shadow-lg shadow-emerald-600/30">
            <span class="flex items-center gap-1.5 text-base"><i class="fa-solid fa-arrow-trend-up"></i> BELI (BUY)</span>
            <span class="text-xs font-mono font-medium text-emerald-100" id="buyLivePriceBadge">1.11890</span>
          </button>

          <!-- Tombol JUAL (SELL) -->
          <button type="button" onclick="executeManualOrder('SELL')" class="p-3.5 rounded-xl bg-rose-600 hover:bg-rose-500 active:scale-95 text-white font-extrabold text-sm transition flex flex-col items-center justify-center gap-1 shadow-lg shadow-rose-600/30">
            <span class="flex items-center gap-1.5 text-base"><i class="fa-solid fa-arrow-trend-down"></i> JUAL (SELL)</span>
            <span class="text-xs font-mono font-medium text-rose-100" id="sellLivePriceBadge">1.11882</span>
          </button>
        </div>

        <!-- Tombol Pengaman: Break-Even & Tutup Semua -->
        <div class="grid grid-cols-2 gap-2 pt-2 border-t border-slate-800">
          <button type="button" onclick="quickSetBreakEven()" class="py-2 px-3 rounded-lg bg-slate-800 hover:bg-slate-700 text-cyan-400 font-bold text-xs border border-slate-700 transition flex items-center justify-center gap-1.5">
            <i class="fa-solid fa-lock"></i> Kunci Impas (BE)
          </button>
          <button type="button" onclick="closeAllTrades()" class="py-2 px-3 rounded-lg bg-rose-500/20 hover:bg-rose-500/30 text-rose-300 font-bold text-xs border border-rose-500/40 transition flex items-center justify-center gap-1.5">
            <i class="fa-solid fa-circle-xmark"></i> Tutup Semua
          </button>
        </div>

        <!-- Emergency Kill Switch -->
        <button type="button" onclick="controlBot('kill-switch')" class="w-full py-2 px-3 rounded-lg bg-red-950/40 hover:bg-red-950/60 text-red-400 border border-red-800/60 font-bold text-xs transition flex items-center justify-center gap-2">
          <i class="fa-solid fa-skull"></i> <span>EMERGENCY KILL SWITCH (Tutup & Matikan)</span>
        </button>

      </div>

      <!-- KOTAK 2: CATATAN AKTIVITAS & LOG BOT REAL-TIME -->
      <div class="trade-card p-4 space-y-2">
        <div class="flex items-center justify-between pb-2 border-b border-slate-800">
          <span class="text-xs font-bold uppercase tracking-wider text-slate-300 flex items-center gap-1.5">
            <i class="fa-solid fa-terminal text-cyan-400"></i> Log Aktivitas Bot
          </span>
          <span class="text-[10px] text-slate-400 font-mono">Live Stream</span>
        </div>

        <!-- Daftar Log Bot Terkini -->
        <div class="space-y-1.5 font-mono text-[11px] text-slate-300 max-h-[160px] xl:max-h-[220px] overflow-y-auto custom-scroll pr-1" id="activityFeedList">
          <div class="p-2 rounded bg-slate-900/80 border border-slate-800 text-slate-300 leading-snug">
            [SYSTEM] Terminal Finex Algo siap. Terhubung ke MT5 Demo #61950031.
          </div>
        </div>
      </div>

    </div>

  </div>

  <!-- ==================================================== -->
  <!-- 4. TABEL POSISI AKTIF & RIWAYAT TRANSAKSI            -->
  <!-- ==================================================== -->
  <div class="w-full trade-card p-3 sm:p-4 mb-3 md:mb-4">
    
    <!-- Header Tab: Posisi Aktif vs Riwayat -->
    <div class="flex flex-wrap items-center justify-between gap-3 pb-3 border-b border-slate-800">
      
      <div class="flex items-center gap-2">
        <!-- Tombol Tab Posisi Aktif -->
        <button type="button" id="tabPosBtn" onclick="switchTableTab('positions')" class="px-4 py-2 rounded-xl bg-blue-600 text-white font-bold text-xs transition flex items-center gap-2 shadow-sm">
          <i class="fa-solid fa-list-check"></i>
          <span>Posisi Aktif Saat Ini</span>
          <span class="px-2 py-0.2 rounded-full bg-blue-900 text-blue-200 text-[10px] font-mono" id="countPositions">0</span>
        </button>

        <!-- Tombol Tab Riwayat Selesai -->
        <button type="button" id="tabHistBtn" onclick="switchTableTab('history')" class="px-4 py-2 rounded-xl bg-slate-800 text-slate-300 hover:text-white font-bold text-xs transition flex items-center gap-2">
          <i class="fa-solid fa-clock-rotate-left"></i>
          <span>Riwayat Hasil Transaksi</span>
          <span class="px-2 py-0.2 rounded-full bg-slate-900 text-slate-400 text-[10px] font-mono" id="countHistory">0</span>
        </button>
      </div>

      <!-- Tombol Ekspor CSV & Lab Backtest -->
      <div class="flex items-center gap-2">
        <button type="button" onclick="exportTradesCSV()" class="px-3 py-1.5 rounded-lg bg-slate-800 hover:bg-slate-700 text-slate-300 font-bold text-xs transition border border-slate-700 flex items-center gap-1.5">
          <i class="fa-solid fa-file-csv text-emerald-400"></i> Download CSV Riwayat
        </button>
        <button type="button" onclick="openModal('modalBacktest')" class="px-3 py-1.5 rounded-lg bg-slate-800 hover:bg-slate-700 text-cyan-400 font-bold text-xs transition border border-slate-700 flex items-center gap-1.5">
          <i class="fa-solid fa-flask"></i> Uji Backtest Lab
        </button>
      </div>

    </div>

    <!-- TABEL 1: POSISI AKTIF SAAT INI -->
    <div id="containerPositions" class="overflow-x-auto custom-scroll mt-3">
      <table class="w-full text-left text-xs font-sans">
        <thead>
          <tr class="text-slate-400 border-b border-slate-800 text-[11px] font-bold uppercase">
            <th class="p-2.5">No. Tiket</th>
            <th class="p-2.5">Pasangan</th>
            <th class="p-2.5">Posisi</th>
            <th class="p-2.5">Lot</th>
            <th class="p-2.5">Harga Buka</th>
            <th class="p-2.5">Harga Sekarang</th>
            <th class="p-2.5">Stop Loss (SL)</th>
            <th class="p-2.5">Take Profit (TP)</th>
            <th class="p-2.5">Untung / Rugi ($)</th>
            <th class="p-2.5 text-right">Aksi</th>
          </tr>
        </thead>
        <tbody id="positionsTableBody" class="divide-y divide-slate-800 font-mono">
          <tr>
            <td colspan="10" class="p-6 text-center text-slate-500 italic font-sans text-xs">
              Tidak ada posisi terbuka saat ini. Bot sedang memindai peluang retracement Fibonacci...
            </td>
          </tr>
        </tbody>
      </table>
    </div>

    <!-- TABEL 2: RIWAYAT TRANSAKSI SELESAI (HIDDEN BY DEFAULT) -->
    <div id="containerHistory" class="overflow-x-auto custom-scroll mt-3 hidden">
      <table class="w-full text-left text-xs font-sans">
        <thead>
          <tr class="text-slate-400 border-b border-slate-800 text-[11px] font-bold uppercase">
            <th class="p-2.5">No. Tiket</th>
            <th class="p-2.5">Pasangan</th>
            <th class="p-2.5">Posisi</th>
            <th class="p-2.5">Lot</th>
            <th class="p-2.5">Harga Buka</th>
            <th class="p-2.5">Harga Tutup</th>
            <th class="p-2.5">Hasil Untung / Rugi</th>
            <th class="p-2.5">Waktu Selesai</th>
          </tr>
        </thead>
        <tbody id="historyTableBody" class="divide-y divide-slate-800 font-mono">
          <tr>
            <td colspan="8" class="p-6 text-center text-slate-500 italic font-sans text-xs">
              Belum ada riwayat transaksi selesai pada sesi ini.
            </td>
          </tr>
        </tbody>
      </table>
    </div>

  </div>

  <!-- ==================================================== -->
  <!-- 5. MODAL LOGIN & PARAMETER AKUN MT5                  -->
  <!-- ==================================================== -->
  <div id="loginModal" class="fixed inset-0 bg-black/80 backdrop-blur-sm z-50 hidden flex items-center justify-center p-4">
    <div class="trade-card w-full max-w-md p-6 space-y-4 border border-slate-700">
      <div class="flex items-center justify-between pb-3 border-b border-slate-800">
        <h3 class="text-base font-bold text-white flex items-center gap-2">
          <i class="fa-solid fa-plug text-blue-400"></i> Pengaturan Akun MetaTrader 5
        </h3>
        <button onclick="closeLoginModal()" class="w-8 h-8 rounded-lg bg-slate-800 text-slate-400 hover:text-white flex items-center justify-center">
          <i class="fa-solid fa-xmark"></i>
        </button>
      </div>

      <div class="space-y-3">
        <div>
          <label class="block text-xs font-semibold text-slate-400 mb-1">Tipe Akun</label>
          <div class="grid grid-cols-2 gap-2">
            <button type="button" id="btnAccDemo" onclick="selectAccountType('DEMO')" class="p-2 rounded-lg bg-emerald-600/20 border border-emerald-500 text-emerald-400 text-xs font-bold">DEMO</button>
            <button type="button" id="btnAccReal" onclick="selectAccountType('REAL')" class="p-2 rounded-lg bg-slate-800 border border-slate-700 text-slate-400 text-xs font-bold">REAL</button>
