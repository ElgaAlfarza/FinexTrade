<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Finex Trade Pro - Institutional Algorithmic Terminal</title>
  
  <!-- Google Fonts: Playfair Display (Serif), Plus Jakarta Sans, JetBrains Mono -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;600;700&family=Playfair+Display:ital,wght@0,600;0,700;0,800;1,600&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  
  <!-- Tailwind CSS -->
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          fontFamily: {
            serif: ['"Playfair Display"', 'Georgia', 'serif'],
            sans: ['"Plus Jakarta Sans"', 'system-ui', 'sans-serif'],
            mono: ['"JetBrains Mono"', 'monospace'],
          },
          colors: {
            wanderBg: '#F6F1EC',
            wanderCard: '#FFFFFF',
            wanderBorder: '#E8E2D9',
            wanderNavy: '#0F2C59',
            wanderAegean: '#1E3A8A',
            wanderSky: '#0284C7',
            wanderAmber: '#D97706',
            wanderEmerald: '#059669',
            wanderCoral: '#DC2626',
            wanderSlate: '#64748B',
          }
        }
      }
    }
  </script>
  
  <!-- Font Awesome Icons -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
  
  <style>
    body {
      background-color: #F6F1EC;
      color: #1E293B;
      font-family: 'Plus Jakarta Sans', sans-serif;
      margin: 0;
      padding: 0;
      -webkit-font-smoothing: antialiased;
    }

    /* Soft Claymorphic / Neumorphic Shadows */
    .clay-card {
      background: #FFFFFF;
      border-radius: 28px;
      border: 1px solid rgba(255, 255, 255, 0.95);
      box-shadow: 0 16px 36px -10px rgba(60, 45, 30, 0.07), 0 3px 10px -2px rgba(60, 45, 30, 0.03);
    }

    .clay-pill {
      background: #FFFFFF;
      border-radius: 9999px;
      box-shadow: 0 4px 14px -2px rgba(60, 45, 30, 0.06), inset 0 1px 1px rgba(255, 255, 255, 0.9);
      border: 1px solid rgba(232, 226, 217, 0.85);
    }

    .clay-inset {
      background: #F4EFEB;
      border-radius: 20px;
      box-shadow: inset 0 2px 5px rgba(60, 45, 30, 0.05);
    }

    .organic-hero {
      border-radius: 40px 24px 38px 28px;
    }

    .custom-scroll::-webkit-scrollbar { width: 5px; height: 5px; }
    .custom-scroll::-webkit-scrollbar-track { background: #F6F1EC; }
    .custom-scroll::-webkit-scrollbar-thumb { background: #D5CDC4; border-radius: 4px; }

    .pulse-dot { animation: pulse 2s cubic-bezier(0.4, 0, 0.6, 1) infinite; }
    @keyframes pulse { 0%, 100% { opacity: 1; } 50% { opacity: 0.35; } }

    /* Die-cut wavy organic visual container */
    .wavy-frame {
      border-radius: 36px 44px 32px 40px;
    }
  </style>
</head>
<body class="min-h-screen flex flex-col p-3 md:p-6 pb-28">

  <!-- TOP WRAPPER: LEFT FLOATING DOCK + MAIN CONTENT -->
  <div class="flex-1 flex gap-5 max-w-[1700px] w-full mx-auto">

    <!-- ========================================== -->
    <!-- 1. LEFT VERTICAL FLOATING DOCK (SIDEBAR)   -->
    <!-- ========================================== -->
    <aside class="hidden lg:flex flex-col items-center justify-between py-6 px-3.5 w-20 bg-white/95 rounded-[36px] shadow-[0_16px_36px_-10px_rgba(60,45,30,0.08)] border border-white sticky top-6 h-[calc(100vh-3rem)]">
      
      <!-- Brand Logo Wave -->
      <div class="flex flex-col items-center gap-1">
        <div class="w-11 h-11 rounded-2xl bg-gradient-to-tr from-wanderNavy to-wanderSky flex items-center justify-center text-white text-lg shadow-md shadow-blue-900/20">
          <i class="fa-solid fa-water"></i>
        </div>
        <span class="text-[10px] font-extrabold tracking-wider text-wanderNavy font-serif uppercase">Finex</span>
      </div>

      <!-- Dock Navigation Icons -->
      <nav class="flex flex-col items-center gap-4">
        <!-- Terminal (Home) -->
        <button onclick="switchTab('terminal')" id="dockBtn-terminal" class="w-12 h-12 rounded-2xl bg-wanderNavy text-white flex flex-col items-center justify-center text-xs shadow-md shadow-blue-950/20 transition group" title="Live Terminal & Positions">
          <i class="fa-solid fa-chart-line text-sm"></i>
          <span class="text-[9px] font-bold mt-0.5">Live</span>
        </button>

        <!-- Backtest Lab -->
        <button onclick="switchTab('backtest')" id="dockBtn-backtest" class="w-12 h-12 rounded-2xl text-wanderSlate hover:text-wanderNavy hover:bg-wanderBg flex flex-col items-center justify-center text-xs transition group" title="Backtest Studio & Lab">
          <i class="fa-solid fa-flask text-sm"></i>
          <span class="text-[9px] font-semibold mt-0.5">Lab</span>
        </button>

        <!-- Strategy Blueprint -->
        <button onclick="switchTab('strategy')" id="dockBtn-strategy" class="w-12 h-12 rounded-2xl text-wanderSlate hover:text-wanderNavy hover:bg-wanderBg flex flex-col items-center justify-center text-xs transition group" title="Strategy Blueprint">
          <i class="fa-solid fa-compass-drafting text-sm"></i>
          <span class="text-[9px] font-semibold mt-0.5">Rules</span>
        </button>

        <!-- MT5 Setup -->
        <button onclick="switchTab('mt5')" id="dockBtn-mt5" class="w-12 h-12 rounded-2xl text-wanderSlate hover:text-wanderNavy hover:bg-wanderBg flex flex-col items-center justify-center text-xs transition group" title="MT5 Diagnostics">
          <i class="fa-solid fa-plug text-sm"></i>
          <span class="text-[9px] font-semibold mt-0.5">MT5</span>
        </button>
      </nav>

      <!-- Bottom Profile / Modal Trigger -->
      <div class="flex flex-col items-center gap-3">
        <button onclick="openLoginModal()" class="w-10 h-10 rounded-full bg-wanderBg border border-wanderBorder text-wanderNavy flex items-center justify-center hover:bg-blue-50 transition shadow-sm" title="Pengaturan Akun / Login">
          <i class="fa-solid fa-user text-xs"></i>
        </button>
      </div>
    </aside>

    <!-- ========================================== -->
    <!-- 2. MAIN DASHBOARD CONTENT AREA             -->
    <!-- ========================================== -->
    <div class="flex-1 flex flex-col space-y-6 min-w-0">

      <!-- TOP HEADER (GREETING + SEARCH + ACCOUNT PILLS) -->
      <header class="flex flex-wrap items-center justify-between gap-4 pt-1">
        
        <!-- Left: Editorial Travel/Trading Heading -->
        <div>
          <div class="flex items-center gap-2">
            <h1 class="text-2xl md:text-3xl font-extrabold text-wanderNavy font-serif tracking-tight">
              Hello, Trader <span class="inline-block hover:rotate-12 transition transform cursor-pointer">👋</span>
            </h1>
          </div>
          <p class="text-xs md:text-sm text-wanderSlate font-sans mt-0.5">
            Discover high-probability institutional setups, trade with discipline.
          </p>
        </div>

        <!-- Center: Search / Filter Capsule Pill -->
        <div class="hidden md:flex items-center gap-2 bg-white px-4 py-2 rounded-full border border-wanderBorder shadow-sm w-72">
          <i class="fa-solid fa-magnifying-glass text-gray-400 text-xs"></i>
          <input type="text" placeholder="Cari aset: EURUSD, XAUUSD..." class="bg-transparent text-xs text-wanderNavy placeholder-gray-400 focus:outline-none w-full font-sans" onkeyup="filterAssetSearch(this.value)" />
        </div>

        <!-- Right: Status Badges & Login Actions -->
        <div class="flex items-center gap-2.5 flex-wrap">
          
          <!-- Mode Pill -->
          <div class="clay-pill px-3.5 py-1.5 flex items-center gap-2 text-xs">
            <span class="text-[10px] text-gray-400 font-bold uppercase tracking-wider">MODE</span>
            <span id="badgeMode" class="font-bold text-wanderAmber px-2 py-0.5 rounded-full bg-amber-50 text-[11px]">PAPER SIM</span>
            <div id="statusDot" class="w-2 h-2 rounded-full bg-emerald-500 pulse-dot"></div>
            <span id="statusText" class="font-bold text-gray-700 text-[11px]">ONLINE</span>
            <span id="badgeAlgoStatus" class="hidden text-[10px] font-bold px-2 py-0.5 rounded-full"></span>
          </div>

          <!-- Reconnect Button -->
          <button id="btnReconnect" onclick="manualReconnect()" class="hidden px-3.5 py-1.5 rounded-full bg-amber-500/10 text-amber-700 hover:bg-amber-500/20 border border-amber-300 text-xs font-bold transition flex items-center gap-1.5 shadow-sm">
            <i class="fa-solid fa-rotate"></i> Reconnect
          </button>

          <!-- Login / Ganti Akun Button -->
          <button id="btnHeaderLogin" onclick="openLoginModal()" class="px-4 py-1.5 rounded-full bg-wanderNavy hover:bg-blue-900 text-white text-xs font-bold transition flex items-center gap-2 shadow-sm shadow-blue-900/20">
            <i class="fa-solid fa-key text-[11px]"></i> <span id="btnHeaderLoginText">Login MT5</span>
          </button>

          <!-- Profile Badge -->
          <div class="w-9 h-9 rounded-full bg-gradient-to-tr from-blue-100 to-amber-100 border border-white shadow-sm flex items-center justify-center text-wanderNavy font-bold text-xs">
            <i class="fa-solid fa-user-astronaut"></i>
          </div>
        </div>
      </header>

      <!-- ========================================== -->
      <!-- TAB 1: LIVE TERMINAL & POSITIONS           -->
      <!-- ========================================== -->
      <div id="tab-terminal" class="space-y-6">

        <!-- ---------------------------------------------------- -->
        <!-- HERO ROW: FEATURED ASSET HERO CARD + WEATHER WIDGET -->
        <!-- ---------------------------------------------------- -->
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-5 items-stretch">
          
          <!-- HERO CARD (SANTORINI MEDITERRANEAN ARTWORK STYLE) -->
          <div class="lg:col-span-8 organic-hero relative overflow-hidden bg-gradient-to-br from-[#0B2545] via-[#134074] to-[#1D4E89] text-white p-7 md:p-8 flex flex-col justify-between shadow-xl shadow-blue-950/15 min-h-[290px]">
            
            <!-- Mediterranean Wave Artwork Ambient Glow -->
            <div class="absolute -right-10 -bottom-10 w-72 h-72 rounded-full bg-sky-400/20 blur-3xl pointer-events-none"></div>
            <div class="absolute right-12 top-6 w-36 h-36 rounded-full bg-amber-300/15 blur-2xl pointer-events-none"></div>
            
            <!-- Hand-drawn Style Tag -->
            <div class="flex items-center justify-between relative z-10">
              <span class="text-[11px] font-extrabold tracking-widest text-sky-200 uppercase font-sans flex items-center gap-2 bg-white/10 backdrop-blur-md px-3 py-1 rounded-full border border-white/20">
                <i class="fa-solid fa-compass"></i> FEATURED ASSET & STRATEGY
              </span>
              <span class="text-xs font-serif italic text-amber-200 opacity-90 hidden sm:inline-block">
                "Trade with calm, let Fibonacci guide."
              </span>
            </div>

            <!-- Main Title & Description -->
            <div class="relative z-10 my-4 space-y-2">
              <div class="flex items-center gap-3">
                <h2 id="heroSymbolTitle" class="text-3xl md:text-5xl font-extrabold font-serif tracking-tight text-white">
                  EURUSD
                </h2>
                <span id="heroCategoryBadge" class="text-xs font-mono font-bold px-2.5 py-1 rounded-full bg-sky-400/20 text-sky-200 border border-sky-300/30">
                  FOREX
                </span>
              </div>
              <p id="heroSymbolSubtitle" class="text-xs md:text-sm text-sky-100/90 max-w-xl leading-relaxed font-sans">
                Euro vs US Dollar • Institutional Fibonacci Golden Zone (50% - 78.6%) • Stop Loss Buffer 2.0 Pips • Target -0.27 Extension.
              </p>
            </div>

            <!-- Hero Action Buttons -->
            <div class="flex flex-wrap items-center gap-3 relative z-10 pt-2">
              <button onclick="controlBot('start')" class="px-5 py-2.5 rounded-full bg-white hover:bg-sky-50 text-wanderNavy text-xs font-extrabold transition shadow-lg flex items-center gap-2 group">
                <span>Start Algo Bot</span>
                <i class="fa-solid fa-arrow-right text-xs group-hover:translate-x-1 transition transform"></i>
              </button>

              <button onclick="openLoginModal()" class="px-4 py-2.5 rounded-full bg-white/15 hover:bg-white/25 text-white border border-white/25 text-xs font-bold transition flex items-center gap-2">
                <i class="fa-solid fa-server"></i>
                <span>Ganti Akun MT5</span>
              </button>
            </div>
          </div>

          <!-- RIGHT WIDGETS (WEATHER-STYLE LIVE EQUITY & TODAY PROFIT) -->
          <div class="lg:col-span-4 flex flex-col gap-4">
            
            <!-- Live Equity & Market Status Widget -->
            <div class="clay-card p-6 flex flex-col justify-between flex-1 relative overflow-hidden">
              <div class="flex items-center justify-between">
                <div>
                  <span class="text-[10px] font-extrabold text-wanderSlate uppercase tracking-wider block font-sans">TOTAL EKUITAS</span>
                  <div class="text-3xl font-extrabold text-wanderNavy font-mono mt-1" id="valEquity">$0.00</div>
                  <span class="text-[11px] text-gray-500 mt-0.5 block">Saldo: <span id="valBalance" class="font-mono font-semibold">$0.00</span></span>
                </div>
                
                <!-- Weather-like Sun / Status Icon -->
                <div class="w-14 h-14 rounded-3xl bg-amber-50 border border-amber-200/60 flex items-center justify-center text-amber-500 text-2xl shadow-sm">
                  <i class="fa-solid fa-sun animate-spin" style="animation-duration: 20s;"></i>
                </div>
              </div>

              <!-- Live Spread & Circuit Breaker Indicators -->
              <div class="grid grid-cols-2 gap-2 mt-4 pt-3 border-t border-gray-100 text-xs">
                <div class="bg-[#FAF7F2] p-2.5 rounded-2xl">
                  <span class="text-[10px] text-gray-400 block font-semibold">SPREAD</span>
                  <span id="tickerSpread" class="font-bold text-wanderNavy font-mono">0.8 pip</span>
                </div>
                <div class="bg-[#FAF7F2] p-2.5 rounded-2xl">
                  <span class="text-[10px] text-gray-400 block font-semibold">CIRCUIT BREAKER</span>
                  <span id="valCircuit" class="font-bold text-amber-600 font-mono">0.0 R</span>
                </div>
              </div>
            </div>

            <!-- Mini Daily & Monthly Profit Tracker Card -->
            <div class="clay-card p-4 flex flex-col justify-between gap-3">
              <div class="flex items-center justify-between">
                <div class="space-y-0.5">
                  <span class="text-[10px] font-extrabold text-wanderSlate uppercase tracking-wider block">UNTUNG HARI INI</span>
                  <div class="flex items-baseline gap-1.5">
                    <span id="valProfitToday" class="text-xl font-bold font-mono text-wanderEmerald">+$0.00</span>
                    <span id="valProfitTodayPct" class="text-xs font-semibold text-emerald-600">(+0.00%)</span>
                  </div>
                </div>
                <div class="w-10 h-10 rounded-2xl bg-emerald-50 text-wanderEmerald flex items-center justify-center text-base shadow-sm">
                  <i class="fa-solid fa-arrow-trend-up"></i>
                </div>
              </div>
              
              <div class="grid grid-cols-2 gap-2 pt-2.5 border-t border-gray-100 text-[11px]">
                <div class="bg-[#FAF7F2] p-2 rounded-xl">
                  <span class="text-gray-400 block text-[9px] font-semibold">SALDO AWAL HARI INI</span>
                  <span id="valDailyStartBal" class="font-mono font-bold text-gray-800">$0.00</span>
                </div>
                <div class="bg-[#FAF7F2] p-2 rounded-xl">
                  <span class="text-gray-400 block text-[9px] font-semibold">EST. SALDO BESOK</span>
                  <span id="valEstBalTomorrow" class="font-mono font-bold text-wanderNavy">$0.00</span>
                </div>
                <div class="col-span-2 pt-1.5 border-t border-dashed border-gray-100 flex items-center justify-between text-xs">
                  <span class="text-gray-400 text-[10px] font-semibold uppercase">Untung Bulan Ini:</span>
                  <div class="flex items-center gap-1 font-mono">
                    <span id="valProfitMonth" class="font-bold text-wanderEmerald">+$0.00</span>
                    <span id="valProfitMonthPct" class="text-[10px] text-emerald-600 font-semibold">(+0.00%)</span>
                  </div>
                </div>
              </div>
            </div>

          </div>
        </div>

        <!-- ---------------------------------------------------- -->
        <!-- ASSET ROW: "PASAR & INSTRUMEN UNGGULAN" (CARDS)     -->
        <!-- ---------------------------------------------------- -->
        <div class="space-y-3">
          <div class="flex items-center justify-between">
            <div>
              <h3 class="text-lg md:text-xl font-bold font-serif text-wanderNavy">
                Pasar & Instrumen Unggulan
              </h3>
              <p class="text-xs text-wanderSlate">
                Pilih aset untuk trading otomatis atau manual: Forex, Emas, dan Kripto 24/7.
              </p>
            </div>

            <!-- Category Filter Tabs -->
            <div class="flex items-center gap-1.5 bg-white p-1 rounded-full border border-wanderBorder shadow-sm text-xs font-bold">
              <button type="button" id="tabCatForex" onclick="selectMarketCategory('FOREX')" class="px-3 py-1 rounded-full bg-wanderNavy text-white transition shadow-sm">
                Forex
              </button>
              <button type="button" id="tabCatGold" onclick="selectMarketCategory('COMMODITY')" class="px-3 py-1 rounded-full text-wanderSlate hover:text-wanderNavy transition">
                Emas
              </button>
              <button type="button" id="tabCatCrypto" onclick="selectMarketCategory('CRYPTO')" class="px-3 py-1 rounded-full text-wanderSlate hover:text-wanderNavy transition flex items-center gap-1">
                Kripto <span class="text-[9px] px-1 py-0.2 rounded-full bg-purple-100 text-purple-700 font-mono">24/7</span>
              </button>
            </div>
          </div>

          <!-- 4 Cards Grid (Inspired by Popular Destinations Santorini, Amalfi, Interlaken, Bali) -->
          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
            
            <!-- Card 1: EURUSD (Euro vs USD) -->
            <div onclick="selectSymbol('EURUSD', 'Euro / US Dollar', 'FOREX')" class="clay-card p-3.5 hover:-translate-y-1 transition duration-200 cursor-pointer group flex flex-col justify-between">
              <div class="h-32 rounded-2xl overflow-hidden relative bg-gradient-to-tr from-[#1E3A8A] to-[#38BDF8] p-3 text-white flex flex-col justify-between shadow-inner">
                <span class="text-[10px] font-bold px-2 py-0.5 rounded-full bg-white/20 backdrop-blur-sm self-start">FOREX</span>
                <div class="flex items-center justify-between">
                  <span class="text-xs font-serif font-bold">Eurozone</span>
                  <i class="fa-solid fa-euro-sign text-xl opacity-80"></i>
                </div>
              </div>
              <div class="pt-3 flex items-center justify-between">
                <div>
                  <h4 class="font-bold text-sm text-wanderNavy font-mono">EURUSD</h4>
                  <span class="text-[11px] text-gray-500 block">Euro vs US Dollar</span>
                </div>
                <div class="w-8 h-8 rounded-full bg-wanderBg group-hover:bg-wanderNavy group-hover:text-white transition flex items-center justify-center text-xs text-wanderNavy">
                  <i class="fa-solid fa-arrow-right"></i>
                </div>
              </div>
            </div>

            <!-- Card 2: XAUUSD (Gold Spot / Emas) -->
            <div onclick="selectSymbol('XAUUSD', 'Emas (Gold Spot)', 'COMMODITY')" class="clay-card p-3.5 hover:-translate-y-1 transition duration-200 cursor-pointer group flex flex-col justify-between">
              <div class="h-32 rounded-2xl overflow-hidden relative bg-gradient-to-tr from-[#B45309] to-[#FBBF24] p-3 text-white flex flex-col justify-between shadow-inner">
                <span class="text-[10px] font-bold px-2 py-0.5 rounded-full bg-white/20 backdrop-blur-sm self-start">EMAS & LOGAM</span>
                <div class="flex items-center justify-between">
                  <span class="text-xs font-serif font-bold">Gold Spot</span>
                  <i class="fa-solid fa-gem text-xl opacity-80"></i>
                </div>
              </div>
              <div class="pt-3 flex items-center justify-between">
                <div>
                  <h4 class="font-bold text-sm text-wanderNavy font-mono">XAUUSD</h4>
                  <span class="text-[11px] text-amber-700 block font-medium">Emas Murni Dunia</span>
                </div>
                <div class="w-8 h-8 rounded-full bg-wanderBg group-hover:bg-amber-600 group-hover:text-white transition flex items-center justify-center text-xs text-wanderNavy">
                  <i class="fa-solid fa-arrow-right"></i>
                </div>
              </div>
            </div>

            <!-- Card 3: BTCUSD (Bitcoin 24/7) -->
            <div onclick="selectSymbol('BTCUSD', 'Bitcoin / USD', 'CRYPTO')" class="clay-card p-3.5 hover:-translate-y-1 transition duration-200 cursor-pointer group flex flex-col justify-between">
              <div class="h-32 rounded-2xl overflow-hidden relative bg-gradient-to-tr from-[#581C87] to-[#A855F7] p-3 text-white flex flex-col justify-between shadow-inner">
                <span class="text-[10px] font-bold px-2 py-0.5 rounded-full bg-white/20 backdrop-blur-sm self-start">KRIPTO 24/7</span>
                <div class="flex items-center justify-between">
                  <span class="text-xs font-serif font-bold">Bitcoin</span>
                  <i class="fa-brands fa-bitcoin text-2xl opacity-90"></i>
                </div>
              </div>
              <div class="pt-3 flex items-center justify-between">
                <div>
                  <h4 class="font-bold text-sm text-wanderNavy font-mono">BTCUSD</h4>
                  <span class="text-[11px] text-purple-700 block font-medium">Buka 24/7 Akhir Pekan</span>
                </div>
                <div class="w-8 h-8 rounded-full bg-wanderBg group-hover:bg-purple-700 group-hover:text-white transition flex items-center justify-center text-xs text-wanderNavy">
                  <i class="fa-solid fa-arrow-right"></i>
                </div>
              </div>
            </div>

            <!-- Card 4: GBPUSD (British Pound) -->
            <div onclick="selectSymbol('GBPUSD', 'British Pound', 'FOREX')" class="clay-card p-3.5 hover:-translate-y-1 transition duration-200 cursor-pointer group flex flex-col justify-between">
              <div class="h-32 rounded-2xl overflow-hidden relative bg-gradient-to-tr from-[#0F766E] to-[#2DD4BF] p-3 text-white flex flex-col justify-between shadow-inner">
                <span class="text-[10px] font-bold px-2 py-0.5 rounded-full bg-white/20 backdrop-blur-sm self-start">FOREX</span>
                <div class="flex items-center justify-between">
                  <span class="text-xs font-serif font-bold">Great Britain</span>
                  <i class="fa-solid fa-sterling-sign text-xl opacity-80"></i>
                </div>
              </div>
              <div class="pt-3 flex items-center justify-between">
                <div>
                  <h4 class="font-bold text-sm text-wanderNavy font-mono">GBPUSD</h4>
                  <span class="text-[11px] text-gray-500 block">Pound vs US Dollar</span>
                </div>
                <div class="w-8 h-8 rounded-full bg-wanderBg group-hover:bg-teal-700 group-hover:text-white transition flex items-center justify-center text-xs text-wanderNavy">
                  <i class="fa-solid fa-arrow-right"></i>
                </div>
              </div>
            </div>

          </div>
        </div>

        <!-- ---------------------------------------------------- -->
        <!-- MAIN CHART & TRADING INTERFACE                      -->
        <!-- ---------------------------------------------------- -->
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-6">

          <!-- CANDLESTICK & FIBONACCI CHART (8 COLS) -->
          <div class="lg:col-span-8 clay-card p-6 flex flex-col">
            
            <!-- Chart Header Controls -->
            <div class="flex flex-wrap items-center justify-between gap-3 pb-4 border-b border-gray-100">
              
              <div class="flex items-center gap-2.5 flex-wrap">
                
                <!-- Dropdown Simbol Aktif -->
                <div class="relative">
                  <button id="btnSymbolDropdown" onclick="toggleSymbolDropdown(event)" class="clay-pill px-3.5 py-1.5 flex items-center gap-2 text-xs font-mono font-bold text-wanderNavy hover:bg-gray-50 transition">
                    <span id="symbolCategoryIcon"><i class="fa-solid fa-money-bill-transfer text-blue-600"></i></span>
                    <span id="selectedSymbolLabel">EURUSD</span>
                    <i class="fa-solid fa-chevron-down text-[10px] text-gray-400"></i>
                  </button>

                  <!-- Menu Dropdown Simbol Lengkap -->
                  <div id="dropdownSymbolMenu" class="hidden absolute left-0 mt-2 w-64 rounded-2xl bg-white border border-wanderBorder shadow-xl z-30 py-2 font-sans text-xs divide-y divide-gray-100">
                    <div class="py-1">
                      <div class="px-3 py-1 text-[10px] font-bold text-blue-600 uppercase tracking-wider bg-blue-50/50">Forex</div>
                      <button onclick="selectSymbol('EURUSD', 'Euro / US Dollar', 'FOREX')" class="w-full text-left px-3.5 py-2 hover:bg-blue-50 flex items-center justify-between text-gray-700">
                        <span>EURUSD <span class="text-[10px] text-gray-400 block">Euro vs USD</span></span>
                        <span id="symcheck-EURUSD" class="text-blue-600 font-bold"><i class="fa-solid fa-check"></i></span>
                      </button>
                      <button onclick="selectSymbol('GBPUSD', 'British Pound', 'FOREX')" class="w-full text-left px-3.5 py-2 hover:bg-blue-50 flex items-center justify-between text-gray-700">
                        <span>GBPUSD <span class="text-[10px] text-gray-400 block">Pound vs USD</span></span>
                        <span id="symcheck-GBPUSD" class="hidden text-blue-600 font-bold"><i class="fa-solid fa-check"></i></span>
                      </button>
                      <button onclick="selectSymbol('USDJPY', 'US Dollar / Yen', 'FOREX')" class="w-full text-left px-3.5 py-2 hover:bg-blue-50 flex items-center justify-between text-gray-700">
                        <span>USDJPY <span class="text-[10px] text-gray-400 block">USD vs Yen</span></span>
                        <span id="symcheck-USDJPY" class="hidden text-blue-600 font-bold"><i class="fa-solid fa-check"></i></span>
                      </button>
                      <button onclick="selectSymbol('AUDUSD', 'Aussie / USD', 'FOREX')" class="w-full text-left px-3.5 py-2 hover:bg-blue-50 flex items-center justify-between text-gray-700">
                        <span>AUDUSD <span class="text-[10px] text-gray-400 block">Aussie vs USD</span></span>
                        <span id="symcheck-AUDUSD" class="hidden text-blue-600 font-bold"><i class="fa-solid fa-check"></i></span>
                      </button>
                    </div>

                    <div class="py-1">
                      <div class="px-3 py-1 text-[10px] font-bold text-amber-600 uppercase tracking-wider bg-amber-50/50">Emas & Logam</div>
                      <button onclick="selectSymbol('XAUUSD', 'Emas (Gold Spot)', 'COMMODITY')" class="w-full text-left px-3.5 py-2 hover:bg-amber-50 flex items-center justify-between text-gray-700">
                        <span>XAUUSD <span class="text-[10px] text-amber-600 block">Gold Spot (Emas)</span></span>
                        <span id="symcheck-XAUUSD" class="hidden text-amber-600 font-bold"><i class="fa-solid fa-check"></i></span>
                      </button>
                      <button onclick="selectSymbol('XAGUSD', 'Perak (Silver Spot)', 'COMMODITY')" class="w-full text-left px-3.5 py-2 hover:bg-amber-50 flex items-center justify-between text-gray-700">
                        <span>XAGUSD <span class="text-[10px] text-gray-400 block">Silver Spot (Perak)</span></span>
                        <span id="symcheck-XAGUSD" class="hidden text-amber-600 font-bold"><i class="fa-solid fa-check"></i></span>
                      </button>
                    </div>

                    <div class="py-1">
                      <div class="px-3 py-1 text-[10px] font-bold text-purple-600 uppercase tracking-wider bg-purple-50/50">Kripto (24/7 Weekend)</div>
                      <button onclick="selectSymbol('BTCUSD', 'Bitcoin / USD', 'CRYPTO')" class="w-full text-left px-3.5 py-2 hover:bg-purple-50 flex items-center justify-between text-gray-700">
                        <span>BTCUSD <span class="text-[10px] text-purple-600 block">Bitcoin vs USD</span></span>
                        <span id="symcheck-BTCUSD" class="hidden text-purple-600 font-bold"><i class="fa-solid fa-check"></i></span>
                      </button>
                      <button onclick="selectSymbol('ETHUSD', 'Ethereum / USD', 'CRYPTO')" class="w-full text-left px-3.5 py-2 hover:bg-purple-50 flex items-center justify-between text-gray-700">
                        <span>ETHUSD <span class="text-[10px] text-purple-600 block">Ethereum vs USD</span></span>
                        <span id="symcheck-ETHUSD" class="hidden text-purple-600 font-bold"><i class="fa-solid fa-check"></i></span>
                      </button>
                    </div>
                  </div>
                </div>

                <!-- Dropdown Timeframe -->
                <div class="relative">
                  <button id="btnTimeframeDropdown" onclick="toggleTimeframeDropdown(event)" class="clay-pill px-3.5 py-1.5 flex items-center gap-2 text-xs font-mono font-bold text-wanderSky hover:bg-gray-50 transition">
                    <i class="fa-regular fa-clock text-wanderSky"></i>
                    <span id="selectedTfLabel">1 Menit</span>
                    <i class="fa-solid fa-chevron-down text-[10px] text-gray-400"></i>
                  </button>

                  <div id="dropdownTimeframeMenu" class="hidden absolute left-0 mt-2 w-44 rounded-2xl bg-white border border-wanderBorder shadow-xl z-30 py-2 font-sans text-xs divide-y divide-gray-100">
                    <div class="py-1">
                      <button onclick="selectTimeframe('M1', '1 Menit')" class="w-full text-left px-3.5 py-2 hover:bg-blue-50 flex items-center justify-between text-gray-700">
                        <span>1 Menit</span>
                        <span id="check-M1" class="text-blue-600 font-bold"><i class="fa-solid fa-check"></i></span>
                      </button>
                      <button onclick="selectTimeframe('M5', '5 Menit')" class="w-full text-left px-3.5 py-2 hover:bg-blue-50 flex items-center justify-between text-gray-700">
                        <span>5 Menit</span>
                        <span id="check-M5" class="hidden text-blue-600 font-bold"><i class="fa-solid fa-check"></i></span>
                      </button>
                      <button onclick="selectTimeframe('M15', '15 Menit')" class="w-full text-left px-3.5 py-2 hover:bg-blue-50 flex items-center justify-between text-gray-700">
                        <span>15 Menit</span>
                        <span id="check-M15" class="hidden text-blue-600 font-bold"><i class="fa-solid fa-check"></i></span>
                      </button>
                      <button onclick="selectTimeframe('M30', '30 Menit')" class="w-full text-left px-3.5 py-2 hover:bg-blue-50 flex items-center justify-between text-gray-700">
                        <span>30 Menit</span>
                        <span id="check-M30" class="hidden text-blue-600 font-bold"><i class="fa-solid fa-check"></i></span>
                      </button>
                    </div>
                    <div class="py-1">
                      <button onclick="selectTimeframe('H1', '1 Jam')" class="w-full text-left px-3.5 py-2 hover:bg-blue-50 flex items-center justify-between text-gray-700">
                        <span>1 Jam</span>
                        <span id="check-H1" class="hidden text-blue-600 font-bold"><i class="fa-solid fa-check"></i></span>
                      </button>
                      <button onclick="selectTimeframe('H4', '4 Jam')" class="w-full text-left px-3.5 py-2 hover:bg-blue-50 flex items-center justify-between text-gray-700">
                        <span>4 Jam</span>
                        <span id="check-H4" class="hidden text-blue-600 font-bold"><i class="fa-solid fa-check"></i></span>
                      </button>
                      <button onclick="selectTimeframe('D1', 'Harian')" class="w-full text-left px-3.5 py-2 hover:bg-blue-50 flex items-center justify-between text-gray-700">
                        <span>Harian</span>
                        <span id="check-D1" class="hidden text-blue-600 font-bold"><i class="fa-solid fa-check"></i></span>
                      </button>
                    </div>
                  </div>
                </div>

                <!-- Timeframe Quick Pills -->
                <div class="hidden sm:flex items-center bg-[#FAF7F2] p-1 rounded-full border border-wanderBorder text-[11px] font-mono">
                  <button onclick="selectTimeframe('M1', '1 Menit')" id="pill-M1" class="px-2.5 py-0.5 rounded-full font-bold bg-wanderNavy text-white transition">M1</button>
                  <button onclick="selectTimeframe('M5', '5 Menit')" id="pill-M5" class="px-2.5 py-0.5 rounded-full text-gray-500 hover:text-wanderNavy transition">M5</button>
                  <button onclick="selectTimeframe('M15', '15 Menit')" id="pill-M15" class="px-2.5 py-0.5 rounded-full text-gray-500 hover:text-wanderNavy transition">M15</button>
                  <button onclick="selectTimeframe('H1', '1 Jam')" id="pill-H1" class="px-2.5 py-0.5 rounded-full text-gray-500 hover:text-wanderNavy transition">H1</button>
                  <button onclick="selectTimeframe('D1', 'Harian')" id="pill-D1" class="px-2.5 py-0.5 rounded-full text-gray-500 hover:text-wanderNavy transition">D1</button>
                </div>

                <span id="chartTrendBadge" class="text-xs px-3 py-1 rounded-full font-bold bg-blue-50 text-wanderNavy border border-blue-200">
                  TREND DETECTING
                </span>
              </div>

              <!-- Fib Legends & Refresh -->
              <div class="flex items-center gap-3 text-xs text-gray-500">
                <span class="flex items-center gap-1.5"><span class="w-3 h-1 bg-amber-500 rounded-full inline-block"></span> Fib 50-78.6%</span>
                <span class="flex items-center gap-1.5"><span class="w-3 h-1 bg-emerald-500 rounded-full inline-block"></span> Target (-0.27)</span>
                <button onclick="refreshChart()" title="Segarkan Chart" class="w-8 h-8 rounded-full hover:bg-gray-100 flex items-center justify-center text-gray-600 transition"><i class="fa-solid fa-rotate-right"></i></button>
              </div>
            </div>

            <!-- ONE-CLICK MANUAL EXECUTION BAR -->
            <div class="mt-4 p-3 rounded-2xl bg-[#FAF7F2] border border-wanderBorder flex flex-wrap items-center justify-between gap-3 text-xs">
              <div class="flex items-center gap-3 flex-wrap">
                <!-- Lot Selector -->
                <div class="flex items-center gap-1.5 bg-white px-2.5 py-1 rounded-full border border-wanderBorder shadow-sm">
                  <span class="text-[10px] text-gray-400 font-bold uppercase">LOT</span>
                  <button type="button" onclick="adjustLot(-0.01)" class="w-6 h-6 flex items-center justify-center rounded-full bg-gray-100 hover:bg-gray-200 text-gray-700 font-bold transition text-xs select-none">-</button>
                  <input type="number" id="manualLotInput" value="0.01" step="0.01" min="0.01" max="100.0" class="w-14 bg-transparent text-center font-mono font-bold text-wanderNavy text-xs focus:outline-none">
                  <button type="button" onclick="adjustLot(0.01)" class="w-6 h-6 flex items-center justify-center rounded-full bg-gray-100 hover:bg-gray-200 text-gray-700 font-bold transition text-xs select-none">+</button>
                </div>

                <!-- Lot Chips -->
                <div class="hidden sm:flex items-center gap-1">
                  <button type="button" onclick="setLotPreset(0.01)" class="px-2 py-0.5 rounded-full bg-white hover:bg-gray-100 border border-wanderBorder text-gray-600 font-mono text-[10px] transition">0.01</button>
                  <button type="button" onclick="setLotPreset(0.05)" class="px-2 py-0.5 rounded-full bg-white hover:bg-gray-100 border border-wanderBorder text-gray-600 font-mono text-[10px] transition">0.05</button>
                  <button type="button" onclick="setLotPreset(0.10)" class="px-2 py-0.5 rounded-full bg-white hover:bg-gray-100 border border-wanderBorder text-gray-600 font-mono text-[10px] transition">0.10</button>
                </div>

                <!-- BUY BUTTON -->
                <button type="button" id="btnManualBuy" onclick="executeManualOrder('BUY')" class="px-4 py-1.5 bg-emerald-600 hover:bg-emerald-700 text-white font-extrabold rounded-full text-xs shadow-md shadow-emerald-700/20 transition flex items-center gap-2">
                  <i class="fa-solid fa-arrow-trend-up"></i>
                  <span>BUY</span>
                  <span id="buyLivePriceBadge" class="bg-emerald-800 text-emerald-100 px-1.5 py-0.5 rounded-full text-[10px] font-mono">-</span>
                </button>

                <!-- SELL BUTTON -->
                <button type="button" id="btnManualSell" onclick="executeManualOrder('SELL')" class="px-4 py-1.5 bg-rose-600 hover:bg-rose-700 text-white font-extrabold rounded-full text-xs shadow-md shadow-rose-700/20 transition flex items-center gap-2">
                  <i class="fa-solid fa-arrow-trend-down"></i>
                  <span>SELL</span>
                  <span id="sellLivePriceBadge" class="bg-rose-800 text-rose-100 px-1.5 py-0.5 rounded-full text-[10px] font-mono">-</span>
                </button>
              </div>

              <!-- JUAL SEMUA BUTTON -->
              <button type="button" onclick="closeAllTrades()" class="px-3.5 py-1.5 bg-rose-50 hover:bg-rose-100 text-rose-700 border border-rose-200 font-bold rounded-full text-xs transition flex items-center gap-1.5 shadow-sm">
                <i class="fa-solid fa-burst"></i> JUAL SEMUA
              </button>
            </div>

            <!-- Canvas Container -->
            <div class="relative flex-1 min-h-[380px] mt-4 w-full rounded-2xl overflow-hidden bg-white border border-gray-100">
              <canvas id="liveChartCanvas" class="w-full h-full"></canvas>
              <div id="chartOverlayInfo" class="absolute top-3 left-3 bg-white/90 backdrop-blur-md p-3 rounded-2xl border border-wanderBorder text-xs space-y-1 font-mono shadow-sm pointer-events-none">
                <div class="text-gray-400 text-[10px] font-extrabold uppercase">HTF Impulse Leg:</div>
                <div class="text-wanderNavy font-bold" id="fibLegInfo">Swing Low: - | Swing High: -</div>
                <div class="text-amber-600 font-semibold" id="fibZoneInfo">Entry Zone: 50% - 78.6%</div>
                <div class="text-emerald-600 font-semibold" id="fibTpInfo">TP Target (-0.27): -</div>
              </div>
            </div>
          </div>

          <!-- RIGHT SIDE: ACTIVE POSITIONS & LIVE LOGS (4 COLS) -->
          <div class="lg:col-span-4 space-y-6 flex flex-col">
            
            <!-- Posisi Aktif & Riwayat Tab Card -->
            <div class="clay-card p-5 flex-1 flex flex-col">
              <div class="flex items-center justify-between pb-3 border-b border-gray-100">
                <div class="flex items-center gap-2">
                  <button type="button" id="btnViewPositions" onclick="switchRightTab('positions')" class="text-xs font-bold px-3 py-1.5 rounded-full bg-wanderNavy text-white transition flex items-center gap-1.5 shadow-sm">
                    <i class="fa-solid fa-layer-group"></i> Posisi (<span id="countPositions">0</span>)
                  </button>
                  <button type="button" id="btnViewHistory" onclick="switchRightTab('history')" class="text-xs font-bold px-3 py-1.5 rounded-full text-gray-500 hover:text-wanderNavy hover:bg-gray-100 transition flex items-center gap-1.5">
                    <i class="fa-solid fa-clock-rotate-left"></i> Riwayat (<span id="countHistory">0</span>)
                  </button>
                </div>
                <span id="pnlHistoryBadge" class="hidden text-xs font-bold px-2 py-0.5 rounded-full bg-emerald-100 text-emerald-800 font-mono">
                  P&L: +$0.00
                </span>
              </div>

              <!-- Posisi Aktif Table -->
              <div id="viewPositionsContainer" class="mt-3 overflow-x-auto custom-scroll max-h-[220px]">
                <table class="w-full text-xs text-left">
                  <thead class="text-[10px] text-gray-400 uppercase bg-[#FAF7F2] sticky top-0 font-bold">
                    <tr>
                      <th class="p-2 rounded-l-xl">Ticket</th>
                      <th class="p-2">Side</th>
                      <th class="p-2">Lot</th>
                      <th class="p-2">Entry</th>
                      <th class="p-2">P&L</th>
                      <th class="p-2 text-right rounded-r-xl">Aksi</th>
                    </tr>
                  </thead>
                  <tbody id="positionsTableBody" class="divide-y divide-gray-100 font-mono">
                    <tr>
                      <td colspan="6" class="p-6 text-center text-gray-400 italic font-sans text-xs">Tidak ada posisi terbuka. Bot sedang memindai peluang...</td>
                    </tr>
                  </tbody>
                </table>
              </div>

              <!-- Riwayat Table -->
              <div id="viewHistoryContainer" class="hidden mt-3 overflow-x-auto custom-scroll max-h-[220px]">
                <table class="w-full text-xs text-left">
                  <thead class="text-[10px] text-gray-400 uppercase bg-[#FAF7F2] sticky top-0 font-bold">
                    <tr>
                      <th class="p-2 rounded-l-xl">Waktu</th>
                      <th class="p-2">Side</th>
                      <th class="p-2">Lot</th>
                      <th class="p-2">Hasil</th>
                      <th class="p-2 text-right rounded-r-xl">Alasan</th>
                    </tr>
                  </thead>
                  <tbody id="historyTableBody" class="divide-y divide-gray-100 font-mono">
                    <tr>
                      <td colspan="5" class="p-6 text-center text-gray-400 italic font-sans text-xs">Belum ada riwayat trade tertutup.</td>
                    </tr>
                  </tbody>
                </table>
              </div>
            </div>

            <!-- Terminal Event Journal Card -->
            <div class="clay-card p-5 flex-1 flex flex-col">
              <div class="flex items-center justify-between pb-3 border-b border-gray-100">
                <h4 class="font-bold text-xs uppercase text-wanderNavy flex items-center gap-2">
                  <i class="fa-solid fa-terminal text-emerald-600"></i> Event Journal & Logs
                </h4>
                <span class="text-[10px] text-gray-400 font-mono">Live stream</span>
              </div>
              <div id="terminalLogs" class="mt-3 p-3 rounded-2xl bg-[#1E293B] text-gray-200 font-mono text-[11px] h-[190px] overflow-y-auto custom-scroll space-y-1.5 shadow-inner">
                <div class="text-gray-400 italic">[SYSTEM] Terminal initialized. Waiting for events...</div>
              </div>
            </div>

          </div>

        </div>

      </div>

      <!-- ========================================== -->
      <!-- TAB 2: BACKTEST STUDIO & LAB               -->
      <!-- ========================================== -->
      <div id="tab-backtest" class="hidden space-y-6">
        <div class="clay-card p-6">
          <h2 class="text-xl font-bold font-serif text-wanderNavy flex items-center gap-2">
            <i class="fa-solid fa-flask text-wanderSky"></i> Backtest Studio & Historical Lab
          </h2>
          <p class="text-xs text-wanderSlate mt-1">Uji parameter strategi Fibonacci terhadap puluhan ribu candle historis nyata.</p>

          <form id="backtestForm" onsubmit="event.preventDefault(); runBacktest();" class="mt-5 grid grid-cols-1 md:grid-cols-4 gap-4 text-xs font-sans">
            <div class="md:col-span-2">
              <label class="block text-gray-600 mb-1 font-semibold">Dataset CSV</label>
              <select id="btDataset" class="w-full bg-[#FAF7F2] border border-wanderBorder rounded-xl p-2.5 text-wanderNavy font-mono focus:outline-none">
                <option value="data/EURUSD_M5.csv">EURUSD M5 (Forex - 30,000 candle)</option>
                <option value="data/EURUSD_M1.csv">EURUSD M1 (Forex - 40,000 candle)</option>
                <option value="data/EURUSD_H1.csv">EURUSD H1 (Forex - 8,000 candle)</option>
                <option value="data/XAUUSD_M5.csv">XAUUSD M5 (Emas - 25,000 candle)</option>
                <option value="data/BTCUSD_M5.csv">BTCUSD M5 (Bitcoin 24/7 - 25,000 candle)</option>
              </select>
            </div>

            <div>
              <label class="block text-gray-600 mb-1 font-semibold">Timeframe Entry</label>
              <select id="btTimeframe" class="w-full bg-[#FAF7F2] border border-wanderBorder rounded-xl p-2.5 text-wanderNavy font-mono focus:outline-none">
                <option value="M5">M5 (Tren M30)</option>
                <option value="M1">M1 (Tren M15)</option>
                <option value="H1">H1 (Tren H4)</option>
              </select>
            </div>

            <div>
              <label class="block text-gray-600 mb-1 font-semibold">SL Placement</label>
              <select id="btSlMode" class="w-full bg-[#FAF7F2] border border-wanderBorder rounded-xl p-2.5 text-wanderNavy font-mono focus:outline-none">
                <option value="structure">Structure (Swing High/Low)</option>
                <option value="candle">Candle (Rejection Wick)</option>
              </select>
            </div>

            <div class="md:col-span-4 flex items-center justify-between pt-2">
              <div class="flex items-center gap-4 text-gray-600">
                <label class="flex items-center gap-1.5 cursor-pointer">
                  <input type="checkbox" id="btBreakEven" class="rounded accent-wanderNavy" />
                  <span>Break-Even (+1R)</span>
                </label>
                <label class="flex items-center gap-1.5 cursor-pointer">
                  <input type="checkbox" id="btSession" class="rounded accent-wanderNavy" />
                  <span>London & NY Filter</span>
                </label>
              </div>

              <button type="submit" id="btnRunBacktest" class="px-6 py-2.5 rounded-full bg-wanderNavy hover:bg-blue-900 text-white font-bold transition flex items-center gap-2 shadow-md">
                <i class="fa-solid fa-play"></i> Jalankan Simulasi Lab
              </button>
            </div>
          </form>

          <!-- Backtest Results Display -->
          <div id="btResultsContainer" class="hidden mt-6 pt-5 border-t border-gray-100">
            <h3 class="text-sm font-bold text-wanderNavy mb-3 font-serif">Ringkasan Statistik Hasil:</h3>
            <div class="grid grid-cols-2 md:grid-cols-4 gap-3 text-xs" id="btMetricsGrid"></div>
          </div>
        </div>
      </div>

      <!-- ========================================== -->
      <!-- TAB 3: STRATEGY BLUEPRINT & RULES          -->
      <!-- ========================================== -->
      <div id="tab-strategy" class="hidden space-y-6">
        <div class="clay-card p-6 space-y-4">
          <h2 class="text-xl font-bold font-serif text-wanderNavy flex items-center gap-2">
            <i class="fa-solid fa-compass-drafting text-amber-600"></i> Blueprint Aturan Institutional Fibonacci
          </h2>
          <p class="text-xs text-wanderSlate leading-relaxed">
            Algoritma ini dibangun dengan prinsip disiplin trader institusi untuk menjaga modal, menolak sinyal palsu pada saat konsolidasi sempit, dan mengeksekusi hanya pada zona retracement Fibonacci emas (50% - 78.6%).
          </p>

          <div class="grid grid-cols-1 md:grid-cols-3 gap-4 pt-2">
            <div class="p-4 rounded-2xl bg-[#FAF7F2] border border-wanderBorder space-y-2">
              <span class="text-xs font-bold text-blue-700 flex items-center gap-1.5"><i class="fa-solid fa-1"></i> Identifikasi Tren HTF</span>
              <p class="text-[11px] text-gray-600 leading-relaxed">Data entry di-resample ke timeframe lebih tinggi (HTF) untuk mendeteksi struktur Higher High + Higher Low (Uptrend) atau Lower High + Lower Low (Downtrend).</p>
            </div>

            <div class="p-4 rounded-2xl bg-[#FAF7F2] border border-wanderBorder space-y-2">
              <span class="text-xs font-bold text-amber-700 flex items-center gap-1.5"><i class="fa-solid fa-2"></i> Zona Masuk Emas Fib</span>
              <p class="text-[11px] text-gray-600 leading-relaxed">Dari leg impulsif terakhir ditarik Fibonacci. Bot hanya mengintai peluang beli/jual ketika harga mengalami koreksi masuk ke area 50% s/d 78.6%.</p>
            </div>

            <div class="p-4 rounded-2xl bg-[#FAF7F2] border border-wanderBorder space-y-2">
              <span class="text-xs font-bold text-emerald-700 flex items-center gap-1.5"><i class="fa-solid fa-3"></i> Konfirmasi Rejection Wick</span>
              <p class="text-[11px] text-gray-600 leading-relaxed">Sinyal hanya dieksekusi jika candle penutupan menunjukkan rejection wick minimal 50% searah tren, membuktikan adanya perlawanan institusi.</p>
            </div>
          </div>
        </div>
      </div>

      <!-- ========================================== -->
      <!-- TAB 4: MT5 SETUP & DIAGNOSTICS             -->
      <!-- ========================================== -->
      <div id="tab-mt5" class="hidden space-y-6">
        <div class="clay-card p-6 space-y-4">
          <h2 class="text-xl font-bold font-serif text-wanderNavy flex items-center gap-2">
            <i class="fa-solid fa-plug text-emerald-600"></i> Setup & Diagnostik MetaTrader 5
          </h2>
          <p class="text-xs text-wanderSlate leading-relaxed">
            Bot Anda menggunakan koneksi IPC langsung ke aplikasi MetaTrader 5 di Windows dengan latensi rendah (&lt; 5ms) dan keamanan terjamin.
          </p>

          <div class="p-4 rounded-2xl bg-[#FAF7F2] border border-wanderBorder space-y-3 text-xs">
            <div class="font-bold text-gray-800">Panduan Menghubungkan Akun MT5:</div>
            <ol class="list-decimal pl-4 space-y-1 text-gray-600 text-[11px]">
              <li>Buka aplikasi MetaTrader 5 di komputer Anda.</li>
              <li>Pastikan tombol <b>Algo Trading</b> di toolbar atas MT5 menyala berwarna hijau (Tekan <b>Ctrl + E</b>).</li>
              <li>Klik tombol <b>Login MT5</b> di pojok kanan atas dashboard ini.</li>
              <li>Masukkan Nomor Akun MT5 dan Kata Sandi trading Anda, lalu klik <b>Hubungkan Sekarang</b>.</li>
            </ol>
            <button onclick="openLoginModal()" class="px-5 py-2 rounded-full bg-wanderNavy text-white font-bold text-xs shadow">
              Buka Dialog Login MT5
            </button>
          </div>
        </div>
      </div>

    </div>
  </div>

  <!-- ========================================== -->
  <!-- 3. BOTTOM FLOATING BOT CONTROLLER          -->
  <!-- (AUDIO PLAYER STYLE LIKE THE REFERENCE!)   -->
  <!-- ========================================== -->
  <div class="fixed bottom-4 left-4 right-4 md:left-28 md:right-8 z-40 max-w-[1500px] mx-auto">
    <div class="clay-card p-3 md:p-4 flex flex-wrap items-center justify-between gap-3 shadow-[0_20px_50px_rgba(40,30,20,0.12)] border border-white/90">
      
      <!-- Left Track Info / Bot Identity -->
      <div class="flex items-center gap-3">
        <div class="w-11 h-11 rounded-2xl bg-gradient-to-tr from-wanderNavy to-wanderSky text-white flex items-center justify-center text-base shadow-sm">
          <i class="fa-solid fa-bolt"></i>
        </div>
        <div>
          <div class="flex items-center gap-2">
            <span class="text-xs font-bold text-wanderNavy font-mono" id="tickerSymbol">EURUSD</span>
            <span id="badgeCategory" class="text-[9px] px-2 py-0.2 rounded-full font-bold bg-blue-100 text-wanderNavy">FOREX</span>
          </div>
          <div class="text-[11px] text-gray-500 font-mono mt-0.5">
            Bid: <span id="tickerBid" class="font-bold text-emerald-700">1.08500</span> / Ask: <span id="tickerAsk" class="font-bold text-rose-700">1.08508</span>
          </div>
        </div>
      </div>

      <!-- Center Player Controls: START BOT, PAUSE, KILL SWITCH -->
      <div class="flex items-center gap-2">
        <button id="btnStart" onclick="controlBot('start')" class="px-5 py-2 bg-wanderNavy hover:bg-blue-900 text-white rounded-full text-xs font-bold shadow-md shadow-blue-950/20 transition flex items-center gap-2">
          <i class="fa-solid fa-play text-xs"></i> <span>START BOT</span>
        </button>

        <button id="btnPause" onclick="controlBot('pause')" class="px-3.5 py-2 bg-amber-500 hover:bg-amber-600 text-white rounded-full text-xs font-bold transition flex items-center gap-1.5 shadow-sm">
          <i class="fa-solid fa-pause text-xs"></i> <span>PAUSE</span>
        </button>

        <button id="btnKill" onclick="controlBot('kill-switch')" class="px-4 py-2 bg-rose-700 hover:bg-rose-800 text-white rounded-full text-xs font-extrabold transition flex items-center gap-1.5 shadow-sm">
          <i class="fa-solid fa-skull text-xs"></i> <span>KILL SWITCH</span>
        </button>
      </div>

      <!-- Right Quick Orders -->
      <div class="flex items-center gap-2">
        <button id="btnQuickBuy" onclick="quickOrder('BUY')" class="px-3.5 py-1.5 bg-emerald-50 hover:bg-emerald-100 text-emerald-800 border border-emerald-300 rounded-full text-xs font-bold transition flex items-center gap-1.5" title="Buka order tes BUY 0.01 lot">
          <i class="fa-solid fa-arrow-trend-up"></i> BUY 0.01
        </button>
        <button id="btnQuickSell" onclick="quickOrder('SELL')" class="px-3.5 py-1.5 bg-rose-50 hover:bg-rose-100 text-rose-800 border border-rose-300 rounded-full text-xs font-bold transition flex items-center gap-1.5" title="Buka order tes SELL 0.01 lot">
          <i class="fa-solid fa-arrow-trend-down"></i> SELL 0.01
        </button>
      </div>

    </div>
  </div>

  <!-- ========================================== -->
  <!-- 4. MODAL LOGIN MT5                         -->
  <!-- ========================================== -->
  <div id="loginModal" class="fixed inset-0 bg-black/40 backdrop-blur-sm z-50 flex items-center justify-center p-4 hidden">
    <div class="clay-card max-w-lg w-full p-6 md:p-8 space-y-5 animate-fadeIn shadow-2xl relative">
      
      <!-- Modal Header -->
      <div class="flex items-center justify-between pb-3 border-b border-gray-100">
        <div class="flex items-center gap-3">
          <div class="w-10 h-10 rounded-2xl bg-blue-50 text-wanderNavy flex items-center justify-center font-bold text-lg">
            <i class="fa-solid fa-server"></i>
          </div>
          <div>
            <h3 class="font-bold text-base text-wanderNavy font-serif">Koneksi MetaTrader 5</h3>
            <p class="text-xs text-gray-500">Pilih jenis akun dan masukkan detail login broker Anda</p>
          </div>
        </div>
        <button onclick="closeLoginModal()" class="w-8 h-8 rounded-full bg-gray-100 hover:bg-gray-200 text-gray-500 flex items-center justify-center transition">&times;</button>
      </div>

      <!-- Tipe Akun Selector -->
      <div>
        <label class="block text-xs font-bold text-gray-700 mb-2">PILIH TIPE AKUN:</label>
        <div class="grid grid-cols-2 gap-2 text-xs font-bold">
          <button type="button" id="btnTypeDemo" onclick="selectAccountType('demo')" class="p-2.5 rounded-2xl border border-emerald-500 bg-emerald-50 text-emerald-800 flex items-center justify-center gap-2 transition shadow-sm">
            <i class="fa-solid fa-shield-heart"></i>
            <span>DEMO (VIRTUAL)</span>
          </button>
          <button type="button" id="btnTypeReal" onclick="selectAccountType('real')" class="p-2.5 rounded-2xl border border-wanderBorder bg-[#FAF7F2] text-gray-500 hover:text-rose-700 flex items-center justify-center gap-2 transition">
            <i class="fa-solid fa-fire text-rose-600"></i>
            <span>REAL (UANG ASLI)</span>
          </button>
        </div>
      </div>

      <!-- Warning Real Account -->
      <div id="realAccountWarning" class="hidden p-3 rounded-2xl bg-rose-50 border border-rose-200 text-xs text-rose-800 space-y-1">
        <div class="font-bold flex items-center gap-1.5"><i class="fa-solid fa-triangle-exclamation"></i> PERHATIAN AKUN REAL:</div>
        <p class="text-[11px] leading-relaxed text-rose-700">Akun Real memperdagangkan modal uang asli Anda. Pastikan risiko 1% per trade telah dipahami.</p>
      </div>

      <!-- Form Inputs -->
      <div class="space-y-3 text-xs">
        <div>
          <label class="block text-gray-600 mb-1 font-semibold">Nomor Login MT5</label>
          <input type="number" id="inputLogin" placeholder="Contoh: 61950031" class="w-full px-4 py-2.5 bg-[#FAF7F2] border border-wanderBorder rounded-xl text-wanderNavy font-mono focus:outline-none focus:border-wanderNavy" />
        </div>

        <div>
          <label class="block text-gray-600 mb-1 font-semibold">Kata Sandi (Password)</label>
          <div class="relative">
            <input type="password" id="inputPassword" placeholder="Masukkan kata sandi trading" class="w-full pl-4 pr-10 py-2.5 bg-[#FAF7F2] border border-wanderBorder rounded-xl text-wanderNavy font-mono focus:outline-none focus:border-wanderNavy" />
            <button type="button" onclick="togglePasswordVisibility()" class="absolute inset-y-0 right-0 pr-3.5 flex items-center text-gray-400 hover:text-gray-600">
              <i id="eyeIcon" class="fa-solid fa-eye"></i>
            </button>
          </div>
        </div>

        <div>
          <div class="flex items-center justify-between mb-1">
            <label class="text-gray-600 font-semibold">Server Broker MT5</label>
            <div class="space-x-1.5 text-[10px]">
              <button type="button" onclick="setServerPreset('FinexBisnisSolusi-Demo')" class="text-emerald-700 hover:underline">Finex Demo</button>
              <span class="text-gray-300">|</span>
              <button type="button" onclick="setServerPreset('FinexBisnisSolusi-Live')" class="text-rose-700 hover:underline">Finex Real</button>
            </div>
          </div>
          <input type="text" id="inputServer" value="FinexBisnisSolusi-Demo" class="w-full px-4 py-2.5 bg-[#FAF7F2] border border-wanderBorder rounded-xl text-wanderNavy font-mono focus:outline-none focus:border-wanderNavy" />
        </div>

        <div id="divTermPathContainer">
          <label class="block text-gray-600 mb-1 font-semibold">Lokasi terminal64.exe (BIARKAN KOSONG)</label>
          <input type="text" id="inputTermPath" placeholder="Biarkan kosong jika MT5 sudah terpasang di Windows" class="w-full px-4 py-2.5 bg-[#FAF7F2] border border-wanderBorder rounded-xl text-wanderNavy text-[11px] font-mono focus:outline-none" />
        </div>
      </div>

      <!-- Alert Box -->
      <div id="loginAlertBox" class="hidden p-3 rounded-2xl text-xs font-mono"></div>

      <!-- Footer Buttons -->
      <div class="flex items-center justify-between pt-3 border-t border-gray-100">
        <button type="button" onclick="disconnectToPaper()" id="btnDisconnectPaper" class="px-4 py-2 bg-gray-100 hover:bg-gray-200 text-gray-700 rounded-full text-xs font-bold transition">
          Gunakan Paper Sim
        </button>
        <div class="flex gap-2">
          <button type="button" onclick="closeLoginModal()" class="px-4 py-2 text-gray-500 hover:text-gray-700 text-xs font-bold transition">
            Batal
          </button>
          <button type="button" id="btnSubmitLogin" onclick="submitLogin()" class="px-5 py-2 bg-wanderNavy hover:bg-blue-900 text-white rounded-full text-xs font-bold shadow transition flex items-center gap-2">
            <i class="fa-solid fa-link"></i> Hubungkan MT5
          </button>
        </div>
      </div>

    </div>
  </div>

  <!-- ========================================== -->
  <!-- JAVASCRIPT LOGIC (100% PRESERVED & SYNCED) -->
  <!-- ========================================== -->
  <script>
    // State aplikasi
    let currentTab = 'terminal';
    let socket = null;
    let telemetryData = null;

    function switchTab(tab) {
      currentTab = tab;
      ['terminal', 'backtest', 'strategy', 'mt5'].forEach(t => {
        const el = document.getElementById(`tab-${t}`);
        const dockBtn = document.getElementById(`dockBtn-${t}`);
        if (t === tab) {
          if (el) el.classList.remove('hidden');
          if (dockBtn) {
            dockBtn.className = "w-12 h-12 rounded-2xl bg-wanderNavy text-white flex flex-col items-center justify-center text-xs shadow-md shadow-blue-950/20 transition group";
          }
        } else {
          if (el) el.classList.add('hidden');
          if (dockBtn) {
            dockBtn.className = "w-12 h-12 rounded-2xl text-wanderSlate hover:text-wanderNavy hover:bg-wanderBg flex flex-col items-center justify-center text-xs transition group";
          }
        }
      });
      if (tab === 'terminal') {
        refreshChart();
      }
    }

    // WebSocket Telemetri
    function initWebSocket() {
      const protocol = window.location.protocol === 'https:' ? 'wss:' : 'ws:';
      const wsUrl = `${protocol}//${window.location.host}/ws/telemetry`;
      socket = new WebSocket(wsUrl);

      socket.onopen = () => {
        document.getElementById('statusText').innerText = 'CONNECTED';
        document.getElementById('statusDot').className = 'w-2 h-2 rounded-full bg-emerald-500 pulse-dot';
      };

      socket.onmessage = (event) => {
        try {
          const msg = JSON.parse(event.data);
          if (msg.type === 'telemetry' || msg.type === 'initial_status') {
            updateUI(msg.data);
          }
        } catch (e) {
          console.error(e);
        }
      };

      socket.onclose = () => {
        document.getElementById('statusText').innerText = 'RECONNECTING';
        document.getElementById('statusDot').className = 'w-2 h-2 rounded-full bg-amber-500';
        setTimeout(initWebSocket, 2000);
      };
    }

    function updateUI(data) {
      telemetryData = data;
      const acc = data.account || {};

      // Badges & Ticker Mode
      const mode = acc.mode || 'PAPER';
      const badgeMode = document.getElementById('badgeMode');
      const btnHeaderLogin = document.getElementById('btnHeaderLogin');
      const btnHeaderLoginText = document.getElementById('btnHeaderLoginText');
      const btnReconnect = document.getElementById('btnReconnect');

      if (mode === 'MT5_DEMO') {
        badgeMode.innerText = `MT5 DEMO (#${acc.login || ''})`;
        badgeMode.className = 'font-bold px-2.5 py-0.5 rounded-full bg-emerald-50 text-emerald-800 text-[11px] border border-emerald-200';
        if (btnHeaderLoginText) btnHeaderLoginText.innerText = 'Ganti Akun';
        if (btnReconnect) btnReconnect.classList.add('hidden');
      } else if (mode === 'MT5_REAL') {
        badgeMode.innerText = `MT5 REAL (#${acc.login || ''})`;
        badgeMode.className = 'font-bold px-2.5 py-0.5 rounded-full bg-rose-50 text-rose-800 text-[11px] border border-rose-200 animate-pulse';
        if (btnHeaderLoginText) btnHeaderLoginText.innerText = 'Ganti Akun';
        if (btnReconnect) btnReconnect.classList.add('hidden');
      } else if (mode === 'MT5_RECONNECTING' || mode === 'MT5_DISCONNECTED') {
        badgeMode.innerText = '⚠️ MT5 TERPUTUS';
        badgeMode.className = 'font-bold px-2.5 py-0.5 rounded-full bg-amber-50 text-amber-800 text-[11px] border border-amber-200 animate-pulse';
        if (btnHeaderLoginText) btnHeaderLoginText.innerText = 'Login Ulang';
        if (btnReconnect) btnReconnect.classList.remove('hidden');
      } else {
        badgeMode.innerText = 'PAPER SIM';
        badgeMode.className = 'font-bold px-2.5 py-0.5 rounded-full bg-amber-50 text-amber-700 text-[11px] border border-amber-200';
        if (btnHeaderLoginText) btnHeaderLoginText.innerText = 'Login MT5';
        if (btnReconnect) btnReconnect.classList.add('hidden');
      }

      const badgeAlgo = document.getElementById('badgeAlgoStatus');
      if (badgeAlgo) {
        if (mode.startsWith('MT5') && mode !== 'MT5_DISCONNECTED' && mode !== 'MT5_RECONNECTING') {
          badgeAlgo.classList.remove('hidden');
          if (acc.terminal_algo_ok) {
            badgeAlgo.innerText = '⚡ ALGO MT5: ON';
            badgeAlgo.className = 'text-[10px] font-bold px-2 py-0.5 rounded-full bg-emerald-50 text-emerald-800 border border-emerald-200';
            badgeAlgo.title = 'Algo Trading diizinkan di MT5';
          } else {
            badgeAlgo.innerText = '⚠️ ALGO: OFF (Ctrl+E)';
            badgeAlgo.className = 'text-[10px] font-bold px-2 py-0.5 rounded-full bg-amber-50 text-amber-800 border border-amber-200 animate-pulse';
            badgeAlgo.title = 'Klik tombol Algo Trading (Ctrl+E) di MT5 agar bot bisa mengeksekusi order';
          }
        } else {
          badgeAlgo.classList.add('hidden');
        }
      }

      const sym = data.symbol || currentSymbol;
      const elTickerSym = document.getElementById('tickerSymbol');
      if (elTickerSym) elTickerSym.innerText = sym;

      let cat = 'FOREX';
      if (sym.includes('XAU') || sym.includes('XAG')) cat = 'COMMODITY';
      else if (sym.includes('BTC') || sym.includes('ETH')) cat = 'CRYPTO';

      const badgeCat = document.getElementById('badgeCategory');
      if (badgeCat) {
        if (cat === 'COMMODITY') {
          badgeCat.innerText = 'EMAS';
          badgeCat.className = 'text-[9px] px-2 py-0.2 rounded-full font-bold bg-amber-100 text-amber-800';
        } else if (cat === 'CRYPTO') {
          badgeCat.innerText = 'KRIPTO 24/7';
          badgeCat.className = 'text-[9px] px-2 py-0.2 rounded-full font-bold bg-purple-100 text-purple-800';
        } else {
          badgeCat.innerText = 'FOREX';
          badgeCat.className = 'text-[9px] px-2 py-0.2 rounded-full font-bold bg-blue-100 text-blue-800';
        }
      }

      const dec = (sym.includes('XAU') || sym.includes('BTC') || sym.includes('ETH') || sym.includes('XAG')) ? 2 : (sym.includes('JPY') ? 3 : 5);
      if (data.bid !== undefined && data.bid !== null) {
        const elBid = document.getElementById('tickerBid');
        if (elBid) elBid.innerText = Number(data.bid).toFixed(dec);
        const buyBadge = document.getElementById('buyLivePriceBadge');
        if (buyBadge) buyBadge.innerText = Number(data.ask || data.bid).toFixed(dec);
      }
      if (data.ask !== undefined && data.ask !== null) {
        const elAsk = document.getElementById('tickerAsk');
        if (elAsk) elAsk.innerText = Number(data.ask).toFixed(dec);
        const sellBadge = document.getElementById('sellLivePriceBadge');
        if (sellBadge) sellBadge.innerText = Number(data.bid || data.ask).toFixed(dec);
      }
      const sp = (data.spread_pips !== undefined) ? data.spread_pips : 0.8;
      const elSpread = document.getElementById('tickerSpread');
      if (elSpread) elSpread.innerText = `${Number(sp).toFixed(1)} pip`;

      // Account Metrics & Profit Tracker
      const curBal = acc.balance !== undefined ? acc.balance : 10000;
      const curEq = acc.equity !== undefined ? acc.equity : curBal;
      document.getElementById('valBalance').innerText = `$${curBal.toLocaleString(undefined, {minimumFractionDigits: 2})}`;
      document.getElementById('valEquity').innerText = `$${curEq.toLocaleString(undefined, {minimumFractionDigits: 2})}`;

      const profToday = acc.profit_today !== undefined ? acc.profit_today : (acc.floating_pnl || 0);
      const profTodayPct = acc.profit_today_pct !== undefined ? acc.profit_today_pct : 0.0;
      const elProfToday = document.getElementById('valProfitToday');
      const elProfTodayPct = document.getElementById('valProfitTodayPct');
      if (elProfToday) {
        const sign = profToday >= 0 ? '+' : '';
        elProfToday.innerText = `${sign}$${profToday.toFixed(2)}`;
        elProfToday.className = profToday >= 0 ? 'text-xl font-bold font-mono text-wanderEmerald' : 'text-xl font-bold font-mono text-wanderCoral';
      }
      if (elProfTodayPct) {
        const sign = profTodayPct >= 0 ? '+' : '';
        elProfTodayPct.innerText = `(${sign}${profTodayPct.toFixed(2)}%)`;
        elProfTodayPct.className = `text-xs font-semibold ${profTodayPct >= 0 ? 'text-emerald-600' : 'text-rose-600'}`;
      }

      const estBalTom = acc.est_balance_tomorrow !== undefined ? acc.est_balance_tomorrow : (curBal + (acc.floating_pnl || 0));
      const elEstBal = document.getElementById('valEstBalTomorrow');
      if (elEstBal) elEstBal.innerText = `$${estBalTom.toLocaleString(undefined, {minimumFractionDigits: 2})}`;

      const dailyStart = acc.daily_start_balance !== undefined ? acc.daily_start_balance : curBal;
      const elDailyStart = document.getElementById('valDailyStartBal');
      if (elDailyStart) elDailyStart.innerText = `$${dailyStart.toLocaleString(undefined, {minimumFractionDigits: 2})}`;

      const profMonth = acc.profit_month !== undefined ? acc.profit_month : profToday;
      const profMonthPct = acc.profit_month_pct !== undefined ? acc.profit_month_pct : profTodayPct;
      const elProfMonth = document.getElementById('valProfitMonth');
      const elProfMonthPct = document.getElementById('valProfitMonthPct');
      if (elProfMonth) {
        const signM = profMonth >= 0 ? '+' : '';
        elProfMonth.innerText = `${signM}$${profMonth.toFixed(2)}`;
        elProfMonth.className = profMonth >= 0 ? 'font-bold text-wanderEmerald' : 'font-bold text-wanderCoral';
      }
      if (elProfMonthPct) {
        const signM = profMonthPct >= 0 ? '+' : '';
        elProfMonthPct.innerText = `(${signM}${profMonthPct.toFixed(2)}%)`;
        elProfMonthPct.className = `text-[10px] font-semibold ${profMonthPct >= 0 ? 'text-emerald-600' : 'text-rose-600'}`;
      }

      const elCircuit = document.getElementById('valCircuit');
      if (elCircuit) elCircuit.innerText = `${Number(data.daily_r || 0).toFixed(1)} R`;

      // Update Active Positions & History Tables
      latestPositions = data.positions || data.open_positions || [];
      renderPositions(latestPositions);
      renderHistory(data.trade_history || []);
      renderLogs(data.logs || []);

      // Realtime redraw chart if candles loaded
      if (latestCandles && latestCandles.length > 0) {
        drawCandlestickChart(latestCandles, latestFib);
      }
    }

    function renderPositions(posList) {
      const tbody = document.getElementById('positionsTableBody');
      const countEl = document.getElementById('countPositions');
      if (countEl) countEl.innerText = posList.length;
      if (!tbody) return;

      if (!posList || posList.length === 0) {
        tbody.innerHTML = `<tr><td colspan="6" class="p-6 text-center text-gray-400 italic font-sans text-xs">Tidak ada posisi terbuka. Bot sedang memindai peluang...</td></tr>`;
        return;
      }

      let html = '';
      posList.forEach(p => {
        const pnl = Number(p.floating_pnl || 0);
        const pnlClass = pnl >= 0 ? 'text-emerald-600 font-bold' : 'text-rose-600 font-bold';
        const sideBadge = p.side === 'BUY' ? 'bg-emerald-100 text-emerald-800' : 'bg-rose-100 text-rose-800';
        html += `
          <tr class="hover:bg-gray-50 transition text-xs">
            <td class="p-2 font-bold text-gray-700">#${p.ticket}</td>
            <td class="p-2"><span class="px-2 py-0.5 rounded-full text-[10px] font-bold ${sideBadge}">${p.side}</span></td>
            <td class="p-2 text-gray-800">${p.lots}</td>
            <td class="p-2 text-gray-800">${Number(p.open_price).toFixed(p.symbol.includes('XAU') ? 2 : 5)}</td>
            <td class="p-2 ${pnlClass}">${pnl >= 0 ? '+' : ''}$${pnl.toFixed(2)}</td>
            <td class="p-2 text-right">
              <button onclick="closeTrade(${p.ticket})" class="px-2.5 py-1 rounded-full bg-rose-50 hover:bg-rose-100 text-rose-700 font-bold text-[10px] transition">Tutup</button>
            </td>
          </tr>
        `;
      });
      tbody.innerHTML = html;
    }

    function renderHistory(histList) {
      const tbody = document.getElementById('historyTableBody');
      const countEl = document.getElementById('countHistory');
      if (countEl) countEl.innerText = histList.length;
      if (!tbody) return;

      if (!histList || histList.length === 0) {
        tbody.innerHTML = `<tr><td colspan="5" class="p-6 text-center text-gray-400 italic font-sans text-xs">Belum ada riwayat trade tertutup.</td></tr>`;
        return;
      }

      let html = '';
      histList.slice(0, 30).forEach(t => {
        const pnl = Number(t.pnl || 0);
        const pnlClass = pnl >= 0 ? 'text-emerald-600 font-bold' : 'text-rose-600 font-bold';
        const sideBadge = t.side === 'BUY' ? 'bg-emerald-100 text-emerald-800' : 'bg-rose-100 text-rose-800';
        html += `
          <tr class="hover:bg-gray-50 transition text-xs">
            <td class="p-2 text-gray-500 text-[10px]">${t.close_time || t.open_time}</td>
            <td class="p-2"><span class="px-2 py-0.5 rounded-full text-[10px] font-bold ${sideBadge}">${t.side}</span></td>
            <td class="p-2 text-gray-800">${t.lots}</td>
            <td class="p-2 ${pnlClass}">${pnl >= 0 ? '+' : ''}$${pnl.toFixed(2)}</td>
            <td class="p-2 text-right text-gray-500">${t.reason || 'Closed'}</td>
          </tr>
        `;
      });
      tbody.innerHTML = html;
    }

    function renderLogs(logs) {
      const container = document.getElementById('terminalLogs');
      if (!container || !logs || logs.length === 0) return;
      let html = '';
      logs.forEach(l => {
        let col = 'text-gray-300';
        if (l.level === 'SIGNAL') col = 'text-emerald-400 font-bold';
        else if (l.level === 'RISK_ALERT') col = 'text-amber-400 font-bold';
        else if (l.level === 'WARNING') col = 'text-rose-400';
        html += `<div><span class="text-gray-500">[${l.time}]</span> <span class="${col}">${l.message}</span></div>`;
      });
      container.innerHTML = html;
      container.scrollTop = container.scrollHeight;
    }

    function switchRightTab(tab) {
      const posContainer = document.getElementById('viewPositionsContainer');
      const histContainer = document.getElementById('viewHistoryContainer');
      const btnPos = document.getElementById('btnViewPositions');
      const btnHist = document.getElementById('btnViewHistory');

      if (tab === 'positions') {
        posContainer.classList.remove('hidden');
        histContainer.classList.add('hidden');
        btnPos.className = "text-xs font-bold px-3 py-1.5 rounded-full bg-wanderNavy text-white transition flex items-center gap-1.5 shadow-sm";
        btnHist.className = "text-xs font-bold px-3 py-1.5 rounded-full text-gray-500 hover:text-wanderNavy hover:bg-gray-100 transition flex items-center gap-1.5";
      } else {
        posContainer.classList.add('hidden');
        histContainer.classList.remove('hidden');
        btnPos.className = "text-xs font-bold px-3 py-1.5 rounded-full text-gray-500 hover:text-wanderNavy hover:bg-gray-100 transition flex items-center gap-1.5";
        btnHist.className = "text-xs font-bold px-3 py-1.5 rounded-full bg-wanderNavy text-white transition flex items-center gap-1.5 shadow-sm";
      }
    }

    // State Simbol & Timeframe
    let currentSymbol = 'EURUSD';
    let currentTimeframe = 'M1';
    let currentTfName = '1 Menit';
    let currentCategory = 'FOREX';
    const allTfs = ['M1', 'M5', 'M15', 'M30', 'H1', 'H4', 'D1', 'W1', 'MN'];
    const allSyms = ['EURUSD', 'GBPUSD', 'USDJPY', 'AUDUSD', 'XAUUSD', 'XAGUSD', 'BTCUSD', 'ETHUSD'];

    function selectMarketCategory(cat) {
      currentCategory = cat;
      const tabForex = document.getElementById('tabCatForex');
      const tabGold = document.getElementById('tabCatGold');
      const tabCrypto = document.getElementById('tabCatCrypto');

      if (tabForex) tabForex.className = 'px-3 py-1 rounded-full text-wanderSlate hover:text-wanderNavy transition';
      if (tabGold) tabGold.className = 'px-3 py-1 rounded-full text-wanderSlate hover:text-wanderNavy transition';
      if (tabCrypto) tabCrypto.className = 'px-3 py-1 rounded-full text-wanderSlate hover:text-wanderNavy transition flex items-center gap-1';

      if (cat === 'FOREX') {
        if (tabForex) tabForex.className = 'px-3 py-1 rounded-full bg-wanderNavy text-white transition shadow-sm';
        selectSymbol('EURUSD', 'Euro / US Dollar', 'FOREX');
      } else if (cat === 'COMMODITY') {
        if (tabGold) tabGold.className = 'px-3 py-1 rounded-full bg-amber-600 text-white transition shadow-sm';
        selectSymbol('XAUUSD', 'Emas (Gold Spot)', 'COMMODITY');
      } else if (cat === 'CRYPTO') {
        if (tabCrypto) tabCrypto.className = 'px-3 py-1 rounded-full bg-purple-700 text-white transition shadow-sm flex items-center gap-1';
        selectSymbol('BTCUSD', 'Bitcoin / USD', 'CRYPTO');
      }
    }

    function toggleTimeframeDropdown(e) {
      if (e) e.stopPropagation();
      const menu = document.getElementById('dropdownTimeframeMenu');
      menu.classList.toggle('hidden');
      const symMenu = document.getElementById('dropdownSymbolMenu');
      if (symMenu) symMenu.classList.add('hidden');
    }

    function toggleSymbolDropdown(e) {
      if (e) e.stopPropagation();
      const menu = document.getElementById('dropdownSymbolMenu');
      menu.classList.toggle('hidden');
      const tfMenu = document.getElementById('dropdownTimeframeMenu');
      if (tfMenu) tfMenu.classList.add('hidden');
    }

    document.addEventListener('click', () => {
      const tfMenu = document.getElementById('dropdownTimeframeMenu');
      if (tfMenu) tfMenu.classList.add('hidden');
      const symMenu = document.getElementById('dropdownSymbolMenu');
      if (symMenu) symMenu.classList.add('hidden');
    });

    async function selectTimeframe(tf, name) {
      currentTimeframe = tf;
      currentTfName = name;
      document.getElementById('selectedTfLabel').innerText = name;

      allTfs.forEach(t => {
        const check = document.getElementById(`check-${t}`);
        if (check) {
          if (t === tf) check.classList.remove('hidden');
          else check.classList.add('hidden');
        }
        const pill = document.getElementById(`pill-${t}`);
        if (pill) {
          if (t === tf) pill.className = "px-2.5 py-0.5 rounded-full font-bold bg-wanderNavy text-white transition";
          else pill.className = "px-2.5 py-0.5 rounded-full text-gray-500 hover:text-wanderNavy transition";
        }
      });

      const menu = document.getElementById('dropdownTimeframeMenu');
      if (menu) menu.classList.add('hidden');

      await refreshChart();

      try {
        await fetch('/api/bot/configure', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ symbol: currentSymbol, timeframe: currentTimeframe })
        });
      } catch (e) {
        console.error(e);
      }
    }

    async function selectSymbol(sym, desc, cat) {
      currentSymbol = sym;
      if (!cat) {
        if (sym.includes('XAU') || sym.includes('XAG')) cat = 'COMMODITY';
        else if (sym.includes('BTC') || sym.includes('ETH')) cat = 'CRYPTO';
        else cat = 'FOREX';
      }
      currentCategory = cat;

      document.getElementById('selectedSymbolLabel').innerText = sym;
      const elTicker = document.getElementById('tickerSymbol');
      if (elTicker) elTicker.innerText = sym;

      // Update Hero Card Titles
      const heroTitle = document.getElementById('heroSymbolTitle');
      if (heroTitle) heroTitle.innerText = sym;
      const heroCat = document.getElementById('heroCategoryBadge');
      if (heroCat) heroCat.innerText = cat;
      const heroSub = document.getElementById('heroSymbolSubtitle');
      if (heroSub) {
        if (cat === 'COMMODITY') heroSub.innerText = `${desc} • Logam Mulia Dunia • Retracement Golden Pocket 50% - 78.6%`;
        else if (cat === 'CRYPTO') heroSub.innerText = `${desc} • Pasar Kripto Aktif 24/7 Akhir Pekan • Volatilitas Tinggi`;
        else heroSub.innerText = `${desc} • Pasar Valuta Asing • Institutional Fibonacci & Multi-Timeframe Engine`;
      }

      // Update Icon
      const iconEl = document.getElementById('symbolCategoryIcon');
      if (iconEl) {
        if (cat === 'COMMODITY') iconEl.innerHTML = '<i class="fa-solid fa-gem text-amber-500"></i>';
        else if (cat === 'CRYPTO') iconEl.innerHTML = '<i class="fa-brands fa-bitcoin text-purple-600"></i>';
        else iconEl.innerHTML = '<i class="fa-solid fa-money-bill-transfer text-blue-600"></i>';
      }

      const menu = document.getElementById('dropdownSymbolMenu');
      if (menu) menu.classList.add('hidden');

      await refreshChart();

      try {
        await fetch('/api/bot/configure', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ symbol: currentSymbol, timeframe: currentTimeframe })
        });
      } catch (e) {
        console.error(e);
      }
    }

    // Chart Renderer di Canvas (Light Cream / White Aesthetic)
    let latestCandles = [];
    let latestFib = null;

    async function refreshChart() {
      try {
        const res = await fetch(`/api/candles?symbol=${currentSymbol}&timeframe=${currentTimeframe}&count=80`);
        const data = await res.json();
        latestCandles = data.candles || [];
        latestFib = data.fib_levels || null;
        drawCandlestickChart(latestCandles, latestFib);
      } catch (e) {
        console.error(e);
      }
    }

    function drawCandlestickChart(candles, fib) {
      const canvas = document.getElementById('liveChartCanvas');
      if (!canvas || !candles || candles.length === 0) return;
      const ctx = canvas.getContext('2d');
      const dpr = window.devicePixelRatio || 1;
      const rect = canvas.getBoundingClientRect();
      canvas.width = rect.width * dpr;
      canvas.height = rect.height * dpr;
      ctx.scale(dpr, dpr);

      const w = rect.width;
      const h = rect.height;
      const axisW = (currentSymbol.includes('BTC') || currentSymbol.includes('ETH')) ? 82 : (currentSymbol.includes('XAU') ? 74 : 68);
      const chartW = w - axisW;
      
      // Clean canvas
      ctx.fillStyle = '#FFFFFF';
      ctx.fillRect(0, 0, w, h);

      const numDec = (currentSymbol.includes('XAU') || currentSymbol.includes('BTC') || currentSymbol.includes('ETH') || currentSymbol.includes('XAG')) ? 2 : (currentSymbol.includes('JPY') ? 3 : 5);

      let minP = Math.min(...candles.map(c => c.low));
      let maxP = Math.max(...candles.map(c => c.high));

      const curLivePrice = (telemetryData && telemetryData.bid && telemetryData.symbol === currentSymbol) ? telemetryData.bid : candles[candles.length - 1].close;
      minP = Math.min(minP, curLivePrice);
      maxP = Math.max(maxP, curLivePrice);

      if (fib) {
        if (fib.leg_low && !isNaN(fib.leg_low)) minP = Math.min(minP, fib.leg_low);
        if (fib.leg_high && !isNaN(fib.leg_high)) maxP = Math.max(maxP, fib.leg_high);
        if (fib.tp_target && !isNaN(fib.tp_target)) {
          minP = Math.min(minP, fib.tp_target);
          maxP = Math.max(maxP, fib.tp_target);
        }
      }

      // Pastikan posisi terbuka dan SL/TP masuk ke skala vertikal chart
      const activeForSymbol = (latestPositions || []).filter(p => (p.symbol || '').toUpperCase() === currentSymbol.toUpperCase());
      activeForSymbol.forEach(p => {
        if (p.open_price) { minP = Math.min(minP, Number(p.open_price)); maxP = Math.max(maxP, Number(p.open_price)); }
        if (p.sl && p.sl > 0) { minP = Math.min(minP, Number(p.sl)); maxP = Math.max(maxP, Number(p.sl)); }
        if (p.tp && p.tp > 0) { minP = Math.min(minP, Number(p.tp)); maxP = Math.max(maxP, Number(p.tp)); }
      });

      const padding = (maxP - minP) * 0.12 || 0.0005;
      minP -= padding;
      maxP += padding;

      const toY = (p) => h - ((p - minP) / (maxP - minP)) * (h - 40) - 20;

      // Draw Grid Garis Horizontal & Label Harga di Sumbu Kanan
      ctx.strokeStyle = '#F1ECE5';
      ctx.lineWidth = 1;
      ctx.fillStyle = '#94A3B8';
      ctx.font = '10px monospace';
      ctx.textAlign = 'right';

      for (let i = 0; i <= 5; i++) {
        const py = 20 + (i * (h - 40)) / 5;
        const pVal = maxP - (i / 5) * (maxP - minP);
        ctx.beginPath();
        ctx.moveTo(0, py);
        ctx.lineTo(chartW, py);
        ctx.stroke();
        ctx.fillText(pVal.toFixed(numDec), w - 6, py + 3);
      }

      ctx.strokeStyle = '#E2DAD0';
      ctx.beginPath();
      ctx.moveTo(chartW, 0);
      ctx.lineTo(chartW, h);
      ctx.stroke();

      // Draw Fib Overlay
      if (fib && fib.fib_50 && fib.fib_786) {
        const badgeTrend = document.getElementById('chartTrendBadge');
        if (badgeTrend) badgeTrend.innerText = fib.trend;
        const fibLeg = document.getElementById('fibLegInfo');
        if (fibLeg) fibLeg.innerText = `Swing Low: ${fib.leg_low.toFixed(numDec)} | High: ${fib.leg_high.toFixed(numDec)}`;
        const fibZone = document.getElementById('fibZoneInfo');
        if (fibZone) fibZone.innerText = `Zone 50%: ${fib.fib_50.toFixed(numDec)} | 78.6%: ${fib.fib_786.toFixed(numDec)}`;
        const fibTp = document.getElementById('fibTpInfo');
        if (fibTp) fibTp.innerText = `TP Target: ${fib.tp_target.toFixed(numDec)}`;

        const yTop = toY(Math.max(fib.fib_50, fib.fib_786));
        const yBot = toY(Math.min(fib.fib_50, fib.fib_786));
        ctx.fillStyle = 'rgba(217, 119, 6, 0.10)';
        ctx.fillRect(0, yTop, chartW, yBot - yTop);

        const drawFibLine = (price, label, col) => {
          const y = toY(price);
          ctx.strokeStyle = col;
          ctx.setLineDash([4, 4]);
          ctx.beginPath();
          ctx.moveTo(0, y);
          ctx.lineTo(chartW, y);
          ctx.stroke();
          ctx.setLineDash([]);
          ctx.fillStyle = col;
          ctx.font = 'bold 9px sans-serif';
          ctx.textAlign = 'left';
          ctx.fillText(label, 6, y - 3);
        };

        drawFibLine(fib.fib_50, 'Fib 50.0%', '#D97706');
        drawFibLine(fib.fib_786, 'Fib 78.6%', '#B45309');
        drawFibLine(fib.tp_target, 'TP Target (-0.27)', '#059669');
      }

      // Draw Candlesticks
      const n = candles.length;
      const barSpacing = chartW / n;
      const barWidth = Math.max(2, barSpacing * 0.65);

      candles.forEach((c, idx) => {
        const x = idx * barSpacing + barSpacing / 2;
        const isBull = c.close >= c.open;
        
        // Colors: Aegean Blue for Bull, Terracotta Rose for Bear
        const color = isBull ? '#1E3A8A' : '#DC2626';

        // Sumbu (Wick)
        const yHigh = toY(c.high);
        const yLow = toY(c.low);
        ctx.strokeStyle = color;
        ctx.lineWidth = 1.2;
        ctx.beginPath();
        ctx.moveTo(x, yHigh);
        ctx.lineTo(x, yLow);
        ctx.stroke();

        // Badan Candle (Body)
        const yOpen = toY(c.open);
        const yClose = toY(c.close);
        const top = Math.min(yOpen, yClose);
        const bodyH = Math.max(1.5, Math.abs(yClose - yOpen));

        ctx.fillStyle = color;
        ctx.fillRect(x - barWidth / 2, top, barWidth, bodyH);
      });

      // Draw Current Live Price Line
      const curY = toY(curLivePrice);
      ctx.strokeStyle = '#0284C7';
      ctx.lineWidth = 1.2;
      ctx.setLineDash([3, 3]);
      ctx.beginPath();
      ctx.moveTo(0, curY);
      ctx.lineTo(chartW, curY);
      ctx.stroke();
      ctx.setLineDash([]);

      // Price Tag on Right Axis
      ctx.fillStyle = '#0F2C59';
      ctx.beginPath();
      ctx.roundRect(chartW + 2, curY - 9, axisW - 4, 18, 5);
      ctx.fill();

      ctx.fillStyle = '#FFFFFF';
      ctx.font = 'bold 9px monospace';
      ctx.textAlign = 'center';
      ctx.fillText(curLivePrice.toFixed(numDec), chartW + (axisW / 2), curY + 3.5);

      // Gambar Garis Posisi Terbuka (Buy/Sell Line, SL, TP)
      activeForSymbol.forEach(p => {
        const isBuy = (p.side || '').toUpperCase() === 'BUY';
        const yEntry = toY(Number(p.open_price));
        const col = isBuy ? '#059669' : '#DC2626';
        const pnl = Number(p.floating_pnl || 0);

        // Garis Dashed Entry di Seluruh Lebar Chart
        ctx.strokeStyle = col;
        ctx.lineWidth = 1.5;
        ctx.setLineDash([6, 3]);
        ctx.beginPath();
        ctx.moveTo(0, yEntry);
        ctx.lineTo(chartW, yEntry);
        ctx.stroke();
        ctx.setLineDash([]);

        // Badge Pill Posisi di Sisi Kiri
        const label = `${p.side} ${p.lots}L @ ${Number(p.open_price).toFixed(numDec)} (${pnl >= 0 ? '+' : ''}$${pnl.toFixed(2)})`;
        ctx.font = 'bold 9px monospace';
        const bw = ctx.measureText(label).width + 16;
        
        ctx.fillStyle = col;
        ctx.beginPath();
        ctx.roundRect(8, yEntry - 10, bw, 20, 6);
        ctx.fill();

        ctx.fillStyle = '#FFFFFF';
        ctx.textAlign = 'left';
        ctx.fillText(label, 16, yEntry + 3.5);

        // Garis Stop Loss jika ada
        if (p.sl && Number(p.sl) > 0) {
          const ySl = toY(Number(p.sl));
          ctx.strokeStyle = '#DC2626';
          ctx.lineWidth = 1.2;
          ctx.setLineDash([3, 3]);
          ctx.beginPath();
          ctx.moveTo(0, ySl);
          ctx.lineTo(chartW, ySl);
          ctx.stroke();
          ctx.setLineDash([]);
          ctx.fillStyle = '#DC2626';
          ctx.font = 'bold 9px monospace';
          ctx.textAlign = 'right';
          ctx.fillText(`SL: ${Number(p.sl).toFixed(numDec)}`, chartW - 8, ySl - 4);
        }

        // Garis Take Profit jika ada
        if (p.tp && Number(p.tp) > 0) {
          const yTp = toY(Number(p.tp));
          ctx.strokeStyle = '#059669';
          ctx.lineWidth = 1.2;
          ctx.setLineDash([3, 3]);
          ctx.beginPath();
          ctx.moveTo(0, yTp);
          ctx.lineTo(chartW, yTp);
          ctx.stroke();
          ctx.setLineDash([]);
          ctx.fillStyle = '#059669';
          ctx.font = 'bold 9px monospace';
          ctx.textAlign = 'right';
          ctx.fillText(`TP: ${Number(p.tp).toFixed(numDec)}`, chartW - 8, yTp - 4);
        }
      });
    }

    // Bot Controls & Orders
    async function controlBot(action) {
      try {
        const res = await fetch(`/api/bot/${action}`, { method: 'POST' });
        const data = await res.json();
        console.log(data);
      } catch (e) {
        alert(`Gagal ${action}: ` + e);
      }
    }

    async function quickOrder(side) {
      try {
        const res = await fetch('/api/trades/quick-order', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ symbol: currentSymbol, side: side, lots: 0.01 })
        });
        const data = await res.json();
        if (!res.ok) alert(data.detail || 'Gagal eksekusi order');
      } catch (e) {
        alert('Gagal order: ' + e);
      }
    }

    function adjustLot(delta) {
      const inp = document.getElementById('manualLotInput');
      let val = (parseFloat(inp.value) || 0.01) + delta;
      val = Math.max(0.01, Math.min(100.0, val));
      inp.value = val.toFixed(2);
    }

    function setLotPreset(lots) {
      document.getElementById('manualLotInput').value = lots.toFixed(2);
    }

    async function executeManualOrder(side) {
      const lots = parseFloat(document.getElementById('manualLotInput').value) || 0.01;
      try {
        const res = await fetch('/api/trades/quick-order', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ symbol: currentSymbol, side: side, lots: lots })
        });
        const data = await res.json();
        if (!res.ok) alert(data.detail || 'Gagal eksekusi');
      } catch (e) {
        alert('Error order: ' + e);
      }
    }

    async function closeTrade(ticket) {
      if (!confirm(`Tutup posisi #${ticket}?`)) return;
      try {
        await fetch(`/api/trades/close/${ticket}`, { method: 'POST' });
      } catch (e) {
        alert('Gagal tutup: ' + e);
      }
    }

    async function closeAllTrades() {
      if (!confirm('Tutup SEMUA posisi terbuka sekarang?')) return;
      try {
        await fetch('/api/trades/close-all', { method: 'POST' });
      } catch (e) {
        alert('Gagal tutup semua: ' + e);
      }
    }

    // Modal Login
    let selectedAccountType = 'demo';

    async function manualReconnect() {
      const btn = document.getElementById('btnReconnect');
      if (btn) { btn.innerHTML = '<i class="fa-solid fa-rotate fa-spin"></i> Menghubungkan...'; btn.disabled = true; }
      try {
        const res = await fetch('/api/account/reconnect', { method: 'POST' });
        const data = await res.json();
        alert(data.message || 'Status koneksi diperbarui');
      } catch (e) {
        alert('Error reconnect: ' + e);
      } finally {
        if (btn) { btn.innerHTML = '<i class="fa-solid fa-rotate"></i> Reconnect'; btn.disabled = false; }
      }
    }

    function openLoginModal() {
      document.getElementById('loginModal').classList.remove('hidden');
      document.getElementById('loginAlertBox').classList.add('hidden');
    }

    function closeLoginModal() {
      document.getElementById('loginModal').classList.add('hidden');
    }

    function selectAccountType(type) {
      selectedAccountType = type;
      const btnDemo = document.getElementById('btnTypeDemo');
      const btnReal = document.getElementById('btnTypeReal');
      const warning = document.getElementById('realAccountWarning');
      const serverInput = document.getElementById('inputServer');

      if (type === 'demo') {
        btnDemo.className = 'p-2.5 rounded-2xl border border-emerald-500 bg-emerald-50 text-emerald-800 flex items-center justify-center gap-2 transition shadow-sm';
        btnReal.className = 'p-2.5 rounded-2xl border border-wanderBorder bg-[#FAF7F2] text-gray-500 hover:text-rose-700 flex items-center justify-center gap-2 transition';
        warning.classList.add('hidden');
        if (serverInput.value.includes('Live')) serverInput.value = 'FinexBisnisSolusi-Demo';
      } else {
        btnReal.className = 'p-2.5 rounded-2xl border border-rose-500 bg-rose-50 text-rose-800 flex items-center justify-center gap-2 transition shadow-sm';
        btnDemo.className = 'p-2.5 rounded-2xl border border-wanderBorder bg-[#FAF7F2] text-gray-500 hover:text-emerald-700 flex items-center justify-center gap-2 transition';
        warning.classList.remove('hidden');
        if (serverInput.value.includes('Demo')) serverInput.value = 'FinexBisnisSolusi-Live';
      }
    }

    function setServerPreset(srv) {
      document.getElementById('inputServer').value = srv;
    }

    function togglePasswordVisibility() {
      const pwd = document.getElementById('inputPassword');
      const icon = document.getElementById('eyeIcon');
      if (pwd.type === 'password') {
        pwd.type = 'text';
        icon.className = 'fa-solid fa-eye-slash';
      } else {
        pwd.type = 'password';
        icon.className = 'fa-solid fa-eye';
      }
    }

    async function submitLogin() {
      const loginVal = document.getElementById('inputLogin').value.trim();
      const pwdVal = document.getElementById('inputPassword').value;
      const srvVal = document.getElementById('inputServer').value.trim();
      const pathVal = document.getElementById('inputTermPath').value.trim();
      const alertBox = document.getElementById('loginAlertBox');
      const btnSubmit = document.getElementById('btnSubmitLogin');

      if (!loginVal || !pwdVal || !srvVal) {
        alertBox.className = 'p-3 rounded-2xl text-xs font-mono bg-rose-50 border border-rose-300 text-rose-800 block';
        alertBox.innerText = 'Harap isi Nomor Login, Password, dan Server MT5.';
        return;
      }

      btnSubmit.disabled = true;
      btnSubmit.innerHTML = `<i class="fa-solid fa-spinner fa-spin"></i> Menghubungkan...`;
      alertBox.className = 'p-3 rounded-2xl text-xs font-mono bg-blue-50 border border-blue-200 text-blue-900 block';
      alertBox.innerText = 'Menginisialisasi koneksi ke MetaTrader 5 Desktop...';

      try {
        const res = await fetch('/api/account/login', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            login: parseInt(loginVal),
            password: pwdVal,
            server: srvVal,
            account_type: selectedAccountType,
            terminal_path: pathVal || null,
          })
        });
        const data = await res.json();
        if (!res.ok) throw new Error(data.detail || 'Koneksi gagal');
        alertBox.className = 'p-3 rounded-2xl text-xs font-mono bg-emerald-50 border border-emerald-300 text-emerald-800 block';
        alertBox.innerText = `✅ Berhasil terhubung ke akun MT5 #${loginVal}! Saldo: $${(data.account.balance || 0).toLocaleString()}`;
        setTimeout(() => closeLoginModal(), 1200);
      } catch (err) {
        alertBox.className = 'p-3 rounded-2xl text-xs font-mono bg-rose-50 border border-rose-300 text-rose-800 block';
        alertBox.innerHTML = `❌ Gagal terhubung: ${err.message}`;
      } finally {
        btnSubmit.disabled = false;
        btnSubmit.innerHTML = `<i class="fa-solid fa-link"></i> Hubungkan MT5`;
      }
    }

    async function disconnectToPaper() {
      if (!confirm('Beralih ke Paper Trading Simulator?')) return;
      try {
        await fetch('/api/account/disconnect', { method: 'POST' });
        closeLoginModal();
      } catch (e) {
        console.error(e);
      }
    }

    // Backtest
    async function runBacktest() {
      const btn = document.getElementById('btnRunBacktest');
      btn.disabled = true;
      btn.innerHTML = `<i class="fa-solid fa-spinner fa-spin"></i> Menghitung...`;

      try {
        const body = {
          csv_file: document.getElementById('btDataset').value,
          timeframe: document.getElementById('btTimeframe').value,
          sl_mode: document.getElementById('btSlMode').value,
          use_break_even: document.getElementById('btBreakEven').checked,
          use_session_filter: document.getElementById('btSession').checked,
        };

        const res = await fetch('/api/backtest/run', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(body)
        });

        const data = await res.json();
        renderBacktestStats(data.stats);
      } catch (e) {
        alert('Gagal backtest: ' + e);
      } finally {
        btn.disabled = false;
        btn.innerHTML = `<i class="fa-solid fa-play"></i> Jalankan Simulasi Lab`;
      }
    }

    function renderBacktestStats(s) {
      const container = document.getElementById('btResultsContainer');
      const grid = document.getElementById('btMetricsGrid');
      container.classList.remove('hidden');

      grid.innerHTML = `
        <div class="bg-[#FAF7F2] p-3 rounded-2xl">
          <span class="text-gray-400 block text-[10px] font-bold">TOTAL TRADES</span>
          <span class="text-base font-bold text-wanderNavy font-mono">${s.trades}</span>
        </div>
        <div class="bg-[#FAF7F2] p-3 rounded-2xl">
          <span class="text-gray-400 block text-[10px] font-bold">WIN RATE</span>
          <span class="text-base font-bold text-emerald-700 font-mono">${s.win_rate}%</span>
        </div>
        <div class="bg-[#FAF7F2] p-3 rounded-2xl">
          <span class="text-gray-400 block text-[10px] font-bold">PROFIT FACTOR</span>
          <span class="text-base font-bold text-blue-700 font-mono">${s.profit_factor}</span>
        </div>
        <div class="bg-[#FAF7F2] p-3 rounded-2xl">
          <span class="text-gray-400 block text-[10px] font-bold">TOTAL R</span>
          <span class="text-base font-bold ${s.total_r >= 0 ? 'text-emerald-700' : 'text-rose-700'} font-mono">${s.total_r >= 0 ? '+' : ''}${s.total_r}R</span>
        </div>
      `;
    }

    function filterAssetSearch(query) {
      if (!query) return;
      const q = query.toUpperCase();
      const match = allSyms.find(s => s.includes(q));
      if (match) {
        selectSymbol(match, match);
      }
    }

    // Startup
    window.addEventListener('load', () => {
      initWebSocket();
      refreshChart();
      window.addEventListener('resize', () => {
        if (latestCandles.length > 0) drawCandlestickChart(latestCandles, latestFib);
      });
    });
  </script>
</body>
</html>
